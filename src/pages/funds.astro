---
/**
 * Every fund this project has priced, and what each one really costs.
 *
 * `src/content/shelf.ts` is the canonical record for a ticker and this page prints the
 * three fields that need no window attached to be read: the published fee, the fee less
 * securities-lending income, and the verdict. Delivered exposures and beat-the-market
 * figures are deliberately absent: each names a panel and a window, they were fitted on
 * different months, and a column of them side by side would be the comparison
 * `rankLoadings` refuses to make.
 *
 * Four things this file must keep doing:
 *
 * 1. **Every number is read from the module.** A fee or a cost typed into the markup is a
 *    number with no source and no `as of`, and it drifts the first time a filing is
 *    re-read. The `feeOf` / `costOf` / `spreadOf` helpers throw rather than coalescing a
 *    missing field to zero, because a silent zero here is a false quote.
 * 2. **One table, fifteen row groups.** The page used to render fifteen separate tables
 *    with fifteen repeated header rows, which cost a screen-reader user any sense of
 *    where one group ended and the next began. A `<th scope="colgroup">` leading each
 *    `<tbody>` is what relates a fund to its group.
 * 3. **Ticker and fund name share one row header.** Two columns put a fund's name most of
 *    a phone screen away from its ticker, and on the card layout below 40rem the name
 *    became a second heading under the label column.
 * 4. **`nothingMeasured` is derived, never listed.** A ticker list would have to be edited
 *    every time a young fund files for the first time, and would be wrong in the window
 *    between the filing and the edit.
 *
 * The reader-facing status words are set here rather than taken from `statusMeta`, whose
 * labels ("Exploratory", "Unresolved") are the research vocabulary and mean nothing to
 * somebody deciding what to buy.
 */
import Breakout from "~/components/Breakout.astro";
import Callout from "~/components/Callout.astro";
import Figure from "~/components/Figure.astro";
import Hero from "~/components/Hero.astro";
import Base from "~/layouts/Base.astro";
import { fundByTicker, shelf, shelfAsOf } from "~/content/shelf";
import type { ShelfCategory, ShelfFund } from "~/content/shelf";
import type { EvidenceStatus } from "~/content/types";

/**
 * What each group is called for a reader, which is not what the data calls it. The keys
 * are the research categories; the values are the only version anybody outside this
 * project would recognise.
 */
const CATEGORY_LABEL = {
  "global-core": "The whole world in one fund",
  "us-core": "US, the whole market",
  "us-value": "US, leaning to cheaper companies",
  "us-small": "US, leaning to smaller companies",
  "us-momentum": "US, leaning to shares that have been rising",
  "us-quality": "US, leaning to more profitable companies",
  "intl-core": "Rich countries outside the US, the whole market",
  "intl-value": "Rich countries outside the US, cheaper companies",
  "intl-small-value": "Rich countries outside the US, smaller and cheaper companies",
  "intl-momentum": "Rich countries outside the US, shares that have been rising",
  "emerging-core": "Emerging markets, the whole market",
  "emerging-value": "Emerging markets, cheaper companies",
  bonds: "Bonds",
  "managed-futures": "Trend-following funds (managed futures)",
  "capital-efficient": "Stacked funds: two holdings for every dollar you put in",
  alternative: "Everything else",
} as const satisfies Readonly<Record<ShelfCategory, string>>;

const ORDER = Object.keys(CATEGORY_LABEL) as readonly ShelfCategory[];

const groups = ORDER.map((category) => ({
  category,
  label: CATEGORY_LABEL[category],
  funds: shelf.filter((fund) => fund.category === category),
})).filter((group) => group.funds.length > 0);

/**
 * A cost as a percentage a year, exact rather than rounded to something readable.
 *
 * Rounding to two decimal places collapses the whole point of the page: VTI at 0.0116%
 * and ITOT at 0.0104% both become 0.01%, and the cheapest fund on the page stops being
 * distinguishable from the second cheapest. Four decimal places, trailing zeros trimmed,
 * never fewer than two.
 */
const pct = (basisPoints: number | null): string => {
  if (basisPoints === null) return "—";
  let body = (Math.abs(basisPoints) / 100).toFixed(4).replace(/0+$/, "");
  while (!/\.\d\d/.test(body)) body = body.includes(".") ? `${body}0` : `${body}.00`;
  return `${basisPoints < 0 ? "−" : ""}${body}%`;
};

/** The same cost in money, on a round ten thousand. One basis point is one dollar. */
const perTenThousand = (basisPoints: number): string =>
  `${basisPoints < 0 ? "−" : ""}$${Math.abs(basisPoints).toFixed(2)}`;

/*
 * Three readers that refuse rather than coalesce. A sentence on this page names these
 * funds by ticker, so a field that disappears from the record has to break the build; a
 * `?? 0` would quietly print a fee of zero as though it had been read.
 */
function feeOf(fund: ShelfFund): number {
  if (fund.expenseRatioBp === null)
    throw new Error(`${fund.ticker} has no fee on record; this page may not quote one.`);
  return fund.expenseRatioBp;
}

function costOf(fund: ShelfFund): number {
  if (fund.netCostBp === null) throw new Error(`${fund.ticker} has no net cost on record; this page may not quote one.`);
  return fund.netCostBp;
}

function spreadOf(fund: ShelfFund): number {
  if (!fund.spread) throw new Error(`${fund.ticker} has no published spread on record; this page may not quote one.`);
  return fund.spread.bp;
}

function recheckOn(fund: ShelfFund): string {
  if (!fund.reviewTrigger) throw new Error(`${fund.ticker} has no dated recheck on record; this page may not name one.`);
  return fund.reviewTrigger.on;
}

/**
 * A fund nothing here has measured: no exposure fitted, no return scored, no cost read,
 * and no structure computed from a holdings filing. Some are too young for the filing to
 * exist; the rest were priced and left there.
 *
 * A fee does not disqualify a fund from this set. A fee is read off a prospectus; it is
 * not a measurement made here.
 */
const nothingMeasured = (fund: ShelfFund) =>
  fund.status === null &&
  fund.loadings.length === 0 &&
  fund.alphaPpYr === null &&
  fund.netCostBp === null &&
  (fund.wrapper?.delta ?? null) === null;

/**
 * The inception date, read from the issuer notes where one was recorded. The shelf keeps
 * it inside the note that cites it rather than as a field, so it is parsed here.
 */
const inceptionOf = (fund: ShelfFund): Date | null => {
  for (const note of fund.issuer?.notes ?? []) {
    const match = /inception (\d{4}-\d{2}-\d{2})/i.exec(note);
    if (match) return new Date(`${match[1]}T00:00:00Z`);
  }
  return null;
};

const THREE_YEARS_MS = 3 * 365.25 * 24 * 60 * 60 * 1000;

/**
 * "Too new to say" is for a fund whose filings cannot exist yet: launched within about
 * three years of the shelf date. An older fund with nothing measured was simply priced.
 */
const tooNew = (fund: ShelfFund): boolean => {
  if (!nothingMeasured(fund)) return false;
  const inception = inceptionOf(fund);
  if (inception === null) return true;
  return new Date(shelfAsOf).getTime() - inception.getTime() < THREE_YEARS_MS;
};

/** The research word for a verdict, in the words a reader would use for it. */
const VERDICT_LABEL = {
  exploratory: "Still in the running",
  "source-reproduced": "Still in the running",
  "independently-reproduced": "Still in the running",
  "walk-forward-tested": "Still in the running",
  "shadow-live": "Still in the running",
  "production-eligible": "Still in the running",
  rejected: "Didn’t make the cut",
  unresolved: "Too close to call",
} as const satisfies Readonly<Record<EvidenceStatus, string>>;

const verdictOf = (fund: ShelfFund): string => {
  if (IN_PORTFOLIOS[fund.ticker]) return "Held here";
  if (fund.status) return VERDICT_LABEL[fund.status];
  return tooNew(fund) ? "Too new to say" : "Priced only";
};

/**
 * Which of the four portfolios hold a fund. Derived from the published holdings, kept
 * separate from the verdict: a fund can be still in the running and held by none of them.
 */
const IN_PORTFOLIOS: Readonly<Record<string, string>> = {
  VT: "Portfolio 1",
  VTI: "Portfolios 2, 3 and 4",
  VTV: "Portfolios 2, 3 and 4",
  VXUS: "Portfolios 2, 3 and 4",
  AVDV: "Portfolios 2, 3 and 4",
  IDMO: "Portfolios 2, 3 and 4",
  AVES: "Portfolios 2, 3 and 4",
  RSST: "Portfolios 3 and 4",
  SCHP: "Portfolio 4",
};

const unmeasured = shelf.filter(tooNew);

const iemg = fundByTicker("IEMG");
const vwo = fundByTicker("VWO");
const ctap = fundByTicker("CTAP");
const rsst = fundByTicker("RSST");
const dfev = fundByTicker("DFEV");
const ffut = fundByTicker("FFUT");

/** What one year of the CTAP-versus-RSST spread gap costs, which is the point of naming it. */
const spreadGapBp = spreadOf(ctap) - spreadOf(rsst);

/*
 * The all-in charge of the three stacked funds that were actually candidates: the fee plus
 * what the funds they hold charge, which is the only figure the three can be compared on.
 * Its range is what the spread gap above has to be read against.
 */
const stackedAllIn = [ctap, rsst, fundByTicker("MATE")]
  .map((fund) => fund.wrapper?.allInCostBp ?? null)
  .filter((value): value is number => value !== null);
if (stackedAllIn.length < 3) {
  throw new Error("the three stacked candidates no longer all carry an all-in cost; the comparison below is stale.");
}
const stackedAllInRangeBp = Math.max(...stackedAllIn) - Math.min(...stackedAllIn);

/**
 * Written once, read twice: into `<thead>`, and into the label each cell shows when the
 * table becomes a list of cards below 40rem.
 */
const COLUMNS = ["Fund", "Fee a year", "Cost after lending", "Verdict"] as const;
---

<Base
  title="Every fund, and what it really costs"
  description={`${shelf.length} funds read from their own filings. What each one charges, what it costs once the income from lending its shares is counted, and the verdict attached to it.`}
  wide
>
  <Hero
    title="Every fund, and what it really costs"
    lede="A fund’s real cost is its published fee minus what it earns by lending out the shares it holds, and that second number reorders the list."
  />

  <div class="prose">
    <p>Funds lend their shares to other investors, mostly to people betting a price will fall, and keep part of
    the payment. That income comes back to you inside the fund, so the fee on the label overstates what you hand
    over. Almost nobody publishes the second number. The <span data-numeric>{shelf.length}</span> funds below were
    read from their own filings on or before <span data-numeric>{shelfAsOf}</span>, and the Cost column is the fee
    minus that lending income.</p>

    <p>Two examples show why the column matters. IEMG charges <span data-numeric>{pct(feeOf(iemg))}</span> a year
    and VWO charges <span data-numeric>{pct(feeOf(vwo))}</span>, and both hold the same emerging-market stocks.
    Lending covers IEMG&rsquo;s whole fee and pays you
    <span data-numeric>{perTenThousand(-costOf(iemg))}</span> on every $10,000 on top, so the fund with the higher
    fee is the cheaper one to own. SPY goes the other way: it costs <Figure id="spy-net-cost" inline /> a year,
    three to five times as much as every other fund tracking the same 500 companies, because a trust set up in
    1993 cannot lend its holdings at all.</p>

    <p>If you are buying to hold for years, compare the Cost column. A cost of
    <span data-numeric>0.10%</span> a year is $10 on every $10,000, every year.</p>

    <Callout kind="caveat" label="How to read the table">
      <p>
        Fee is what the fund publishes. Cost is the fee minus lending income, and it is what you actually pay. A
        dash in the Cost column means nobody has read that fund&rsquo;s lending income yet, not that the fund
        lends nothing.
      </p>
    </Callout>
  </div>

  <Breakout scroll class="mt-12" heading="Every fund, by what it is for" maxWidth="52rem">
    <table role="table" class="stack-table w-full border-collapse text-base sm:min-w-[44rem]">
      <caption class="sr-only">
        Every fund priced here, grouped by what it is for, with the fee it publishes, what it costs after
        securities-lending income, and the verdict attached to it
      </caption>
      <thead role="rowgroup">
        <tr role="row" class="border-b border-rule-strong text-left">
          {
            COLUMNS.map((heading, i) => (
              <th
                role="columnheader"
                scope="col"
                class:list={["eyebrow py-2", i < COLUMNS.length - 1 && "pr-4", (i === 1 || i === 2) && "text-right"]}
              >
                {heading}
              </th>
            ))
          }
        </tr>
      </thead>
      {
        groups.map((group) => (
          <tbody role="rowgroup" class="text-ink-muted">
            <tr role="row" class="group-head">
              <th
                role="columnheader"
                scope="colgroup"
                colspan={COLUMNS.length}
                class="h3 border-b border-rule-strong pt-10 pb-2 text-left"
              >
                {group.label}
              </th>
            </tr>
            {group.funds.map((fund) => (
              <tr role="row" class="border-b border-rule align-top">
                <th role="rowheader" scope="row" class="py-2 pr-4 text-left font-normal">
                  <span class="block font-semibold text-ink">{fund.ticker}</span>
                  <span class="block text-xs leading-snug text-ink-3">{fund.name}</span>
                </th>
                <td role="cell" data-label={COLUMNS[1]} data-numeric class="py-2 pr-4 text-right">
                  {pct(fund.expenseRatioBp)}
                </td>
                <td role="cell" data-label={COLUMNS[2]} data-numeric class="py-2 pr-4 text-right">
                  {pct(fund.netCostBp)}
                </td>
                <td role="cell" data-label={COLUMNS[3]} class="py-2 text-xs sm:whitespace-nowrap">
                  <span class="block">{verdictOf(fund)}</span>
                  {IN_PORTFOLIOS[fund.ticker] && (
                    <span class="held-in block text-ink-3">{IN_PORTFOLIOS[fund.ticker]}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </Breakout>

  <div class="prose mt-12">
    <h2>What the verdict words mean</h2>

    <p>Every fund carries one of six words.</p>

    <ul>
      <li><strong>Held here.</strong> One of the nine funds the <a href="/portfolios/">four portfolios</a> hold,
      with the portfolios it belongs to underneath. VTV is held even though, measured on its own, a cheap mix of
      VTI and a small-company fund does much the same job; the
      <a href="/portfolios/value-lean/">value-lean page</a> says why it stays.</li>
      <li><strong>Still in the running.</strong> The fund delivers what it sells, and nothing has ruled it
      out. It can be still in the running and held by none of the four portfolios.</li>
      <li><strong>Didn&rsquo;t make the cut.</strong> The fund was measured against a cheap combination that
      does much the same job, and it lost.</li>
      <li><strong>Too close to call.</strong> The fund has too few months of history for the data to say either
      way. That is a statement about the evidence, not about the fund.</li>
      <li><strong>Too new to say.</strong> The fund is under three years old, so the filings that would show
      what it holds do not exist yet. You get a fee, because a fee is printed in a prospectus. You do not get a
      cost or a verdict. Today that is
      <span data-numeric>{unmeasured.map((fund) => fund.ticker).join(", ")}</span>.</li>
      <li><strong>Priced only.</strong> The fee was read, and where the fund lends its holdings the cost after
      lending too, and no comparison was run.</li>
    </ul>

    <p>There is no beat-the-market column. Whether a fund beat what its holdings alone would have paid is a
    question the data almost never answers, and a column of those answers would read as a finding when it is
    mostly noise.</p>
  </div>

  <div class="prose mt-12">
    <h2>Two things that matter besides the fee</h2>

    <p><strong>The spread.</strong> The spread is the gap between the price you buy at and the price you could
    sell at, and you pay it once, on the way in. Over a long hold the yearly fee wins: SPY has the tightest
    spread of any fund here and still costs the most to own. Over a short hold the spread can decide.
    CTAP&rsquo;s spread is <Figure id="ctap-spread" inline showUnit={false} /> of its price against RSST&rsquo;s
    <Figure id="rsst-spread" inline showUnit={false} />. Hold either for one year and that gap is worth about
    <span data-numeric>{pct(spreadGapBp)}</span>, on a group of three funds whose all-in charges differ by only
    <span data-numeric>{pct(stackedAllInRangeBp)}</span>.</p>

    <p><strong>Fees with an end date.</strong> Some published fees hold only while a waiver runs. DFEV&rsquo;s
    <span data-numeric>{pct(feeOf(dfev))}</span> holds through <span data-numeric>{recheckOn(dfev)}</span>.
    FFUT&rsquo;s <span data-numeric>{pct(feeOf(ffut))}</span> is a cap its board can let lapse after
    <span data-numeric>{recheckOn(ffut)}</span>. CTAP charges less than the
    <span data-numeric>{pct(feeOf(ctap))}</span> shown until <span data-numeric>{recheckOn(ctap)}</span>. If you
    still hold any of these past those dates, read the fee again.</p>
  </div>

  <Callout kind="caveat" label="Where this comes from">
    <p>
      Fees and lending income come from each fund&rsquo;s own annual filings. Spreads come from the 30-day
      figure every exchange-traded fund has to publish. Everything here was read on or before
      <span data-numeric>{shelfAsOf}</span>. Fund facts go stale, so a year from now the right move is to read
      them again rather than to quote this page.
    </p>
  </Callout>
</Base>

<style>
  /* Below 40rem `.stack-table` turns every row into a bordered card. A row group's own
     header is a heading rather than a card, so it opts out of the box and keeps the
     spacing that separates one group from the next. */
  @media (width < 40rem) {
    .stack-table > tbody > tr.group-head {
      display: block;
      border: 0;
      border-radius: 0;
      background: transparent;
      padding: 1.5rem 0 0.5rem;
    }

    .stack-table > tbody > tr.group-head > th {
      border-bottom: 1px solid var(--rule-strong);
      padding-bottom: 0.4rem;
    }

    .stack-table > tbody > tr.group-head + tr {
      margin-top: 0;
    }
  }
</style>
