---
/**
 * The funds the four portfolios hold, the cheaper alternative for each, and the funds the
 * strategies pages reject, with what each one charges and what it costs once the income
 * from lending its shares is counted.
 *
 * Every number is read from `src/content/shelf.ts`; a fee typed into the markup would have
 * no source and no date. The verdict word comes from `fundVerdict` there, given the tickers
 * the four portfolios print, so the page cannot invent a fifth word. The one-line reason
 * beside each verdict is the only prose here per fund, and each line restates a fact a
 * strategy or portfolio page carries.
 */
import Callout from "~/components/Callout.astro";
import Figure from "~/components/Figure.astro";
import Hero from "~/components/Hero.astro";
import { PORTFOLIOS } from "~/content/portfolios";
import { fundByTicker, fundVerdict, type FundVerdict, type ShelfFund, shelfAsOf } from "~/content/shelf";
import Base from "~/layouts/Base.astro";
import { asOfLabel } from "~/lib/site";

/** A cost as a percentage a year, to as many decimals as it needs and never fewer than two. */
const pct = (basisPoints: number | null): string => {
  if (basisPoints === null) return "—";
  let body = (Math.abs(basisPoints) / 100).toFixed(4).replace(/0+$/, "");
  while (!/\.\d\d/.test(body)) body = body.includes(".") ? `${body}0` : `${body}.00`;
  return `${basisPoints < 0 ? "−" : ""}${body}%`;
};

/** The same cost in money on $10,000. One hundredth of a percent is one dollar. */
const dollars = (basisPoints: number): string => `${basisPoints < 0 ? "−" : ""}$${Math.abs(basisPoints).toFixed(2)}`;

function feeOf(fund: ShelfFund): number {
  if (fund.expenseRatioBp === null) throw new Error(`${fund.ticker} has no fee on record; this page may not quote one.`);
  return fund.expenseRatioBp;
}

function costOf(fund: ShelfFund): number {
  if (fund.netCostBp === null) throw new Error(`${fund.ticker} has no net cost on record; this page may not quote one.`);
  return fund.netCostBp;
}

/** Which portfolios hold a ticker, from the printed holdings. */
const heldIn = new Map<string, number[]>();
for (const p of PORTFOLIOS) {
  for (const h of p.holdings) heldIn.set(h.ticker, [...(heldIn.get(h.ticker) ?? []), p.number]);
}
const held: ReadonlySet<string> = new Set(heldIn.keys());

const listOf = (numbers: readonly number[]): string =>
  numbers.length === 1
    ? `Portfolio ${numbers[0]}`
    : `Portfolios ${numbers.slice(0, -1).join(", ")} and ${numbers[numbers.length - 1]}`;

/**
 * The rows, grouped in plain words, and the one-line reason printed beside each verdict.
 * A held fund's line is where it is held; the rest restate the strategy or portfolio page.
 */
const GROUPS: readonly { label: string; rows: readonly [string, string][] }[] = [
  {
    label: "The whole world in one fund",
    rows: [["VT", "Every listed company in the world"]],
  },
  {
    label: "US stocks",
    rows: [
      ["VTI", "The whole US market"],
      ["VOO", "The 500 largest US companies, in place of the whole market"],
      ["ITOT", "The whole US market, and the cheapest of the four to own"],
      ["SPY", "Cannot lend its shares, so the dearest S&P 500 fund"],
      ["VTV", "Big cheap US companies"],
      ["AVUV", "Small cheap US companies; mostly a small-company bet, not added"],
      ["RPV", "Buys cheapness by selling profitability"],
      ["QVAL", "Sells and replaces 332% of its holdings a year"],
      ["MTUM", "Sells and replaces 116% of its holdings a year, costing more than the gain"],
      ["SPMO", "Worth about 0.02% a year at 5%, and overlaps IDMO"],
      ["QUAL", "Not a hedge: lost 27.7% over January to September 2022 against 24.9% for the market"],
    ],
  },
  {
    label: "Foreign stocks",
    rows: [
      ["VXUS", "Developed and emerging markets in one fund"],
      ["VEA", "Developed markets only; with VWO it replaces VXUS"],
      ["SPDW", "Developed markets only; the cheapest fund on this page to own"],
      ["VWO", "Emerging markets by size"],
      ["IEMG", "Emerging markets; lending covers its whole fee"],
      ["AVDV", "Small, cheap, profitable foreign companies"],
      ["IDMO", "Foreign shares that have been rising; retirement account only"],
      ["IMTM", "The dearer of the two foreign rising-share funds"],
      ["AVES", "Cheap emerging-market companies"],
    ],
  },
  {
    label: "Bonds and cash",
    rows: [
      ["SCHP", "Inflation-protected US government bonds"],
      ["TIP", "The same bonds as SCHP at six times the cost"],
      ["VTIP", "Short inflation-protected bonds, with almost no interest-rate swing"],
      ["STIP", "Short inflation-protected bonds, with almost no interest-rate swing"],
      ["SGOV", "Cash as a fund"],
      ["BOXX", "A cash-like return paid as a rise in price, so tax falls when you sell"],
      ["TLT", "Long US government bonds: a bet on rates falling"],
      ["LQD", "Government bonds plus a slice of stock risk"],
    ],
  },
  {
    label: "Trend-following and stacked funds",
    rows: [
      ["RSST", "A dollar of US stocks plus a dollar of trend following"],
      ["CTAP", "First in the replacement queue for RSST; a 0.33% gap between buy and sell prices"],
      ["RSSB", "Stocks plus borrowed government bonds; tested as an idea, not added"],
      ["NTSX", "90% stocks plus 60% government bonds per dollar; the cheapest stacked fund with a record"],
      ["GDE", "Stocks plus borrowed gold; pays out 1.53% a year taxed like wages"],
      ["RSSY", "Stocks plus carry; two years old, look again in mid-2027"],
      ["DBMF", "Trend following on its own, measured against a model"],
      ["CTA", "Trend following on its own; bought by selling stocks it gives up the stock return"],
      ["KMLM", "Trend following on its own; bought by selling stocks it gives up the stock return"],
    ],
  },
  {
    label: "Gold, bitcoin, commodities and the rest",
    rows: [
      ["IAUM", "Gold in a vault; the cheapest of the four gold funds"],
      ["GLD", "The same gold at four times IAUM's fee"],
      ["IBIT", "Bitcoin; the largest fund"],
      ["BTC", "Bitcoin; the cheapest fund"],
      ["PDBC", "Commodities; sends an ordinary 1099 where DBC sends a K-1"],
      ["SCHD", "The market with a screen and a tax bill"],
      ["VNQ", "Property: 112% of the market's falls for 80% of its rises"],
      ["SSO", "Twice the daily move of the S&P 500, with borrowed money"],
    ],
  },
];

interface Row {
  fund: ShelfFund;
  verdict: FundVerdict;
  note: string;
}

const groups = GROUPS.map((g) => ({
  label: g.label,
  rows: g.rows.map(([ticker, reason]): Row => {
    const fund = fundByTicker(ticker);
    const verdict = fundVerdict(fund, held);
    const holders = heldIn.get(ticker);
    return { fund, verdict, note: verdict === "Held" && holders ? `${listOf(holders)}. ${reason}` : reason };
  }),
}));

const rowCount = groups.reduce((sum, g) => sum + g.rows.length, 0);
const heldCount = held.size;

const iemg = fundByTicker("IEMG");
const vwo = fundByTicker("VWO");
const ctap = fundByTicker("CTAP");
const recheck = ctap.reviewTrigger?.on;
if (recheck === undefined) throw new Error("CTAP has no dated recheck on record; this page may not name one.");

const COLUMNS = ["Fund", "Fee a year", "Cost after lending", "Verdict", "Why"] as const;
---

<Base
  title="Funds"
  description={`${rowCount} funds: the ${heldCount} the four portfolios hold, a cheaper alternative for each, and the funds the strategies pages reject, with the fee each publishes and what it costs once the income from lending its shares is counted.`}
  xl
>
  <Hero
    title="The funds, and what each one really costs"
    lede={`The ${heldCount} funds the four portfolios hold, a cheaper alternative for each, and the funds the other pages reject, each with its fee and what it costs once the income from lending its shares is counted.`}
  />

  <div class="prose mt-8">
    <p>A fund's real cost is its published fee minus what it earns lending its shares to other investors, mostly
    people betting a price will fall. That income comes back to you inside the fund, so the fee on the label
    overstates what you pay, and almost nobody publishes the second number. IEMG charges {pct(feeOf(iemg))} a
    year and VWO {pct(feeOf(vwo))}, and both hold the same emerging-market stocks; lending covers IEMG's whole
    fee and pays you {dollars(-costOf(iemg))} on every $10,000 besides, so the fund with the higher fee is the
    cheaper one to own. SPY goes the other way: it costs <Figure id="spy-net-cost" inline /> a year, three to
    five times every other fund tracking the same 500 companies, because a trust set up in 1993 cannot lend
    its holdings. A dash in the cost column means nobody has read that fund's lending income, not that it lends
    nothing. A cost of 0.10% a year is $10 on every $10,000, every year.</p>

    <p>Each fund carries one of four words. <strong>Held</strong>: one of the four portfolios holds it, and the
    line says which. <strong>Fine alternative</strong>: the same holding as a held fund at an equal or lower
    fee; buy it if your broker offers it more cheaply. <strong>Rejected</strong>: a test written down in
    advance, and it failed; the line says how, and the <a href="/strategies/">strategies pages</a> say the
    rest. <strong>Not assessed</strong>: the fee was read and no comparison was run, either because the fund is
    under three years old or because nothing about it needed testing.</p>

    <p>Two things count besides the fee. The gap between the price you buy at and the price you could sell at is
    paid once, on the way in: CTAP's is <Figure id="ctap-spread" inline showUnit={false} /> of its price against
    RSST's <Figure id="rsst-spread" inline showUnit={false} />, which over a one-year hold outweighs the
    difference in their fees. And some fees have an end date: CTAP charges less than the fee shown until
    {asOfLabel(recheck)}, and about 0.99% all in after it. Everything here was read from the funds' own
    filings on or before {asOfLabel(shelfAsOf)}; fund facts go stale, so a year from now read them again
    rather than quoting this page.</p>
  </div>

  <div class="wide mt-12">
    <table class="fund-table w-full border-collapse text-base">
      <caption class="sr-only">
        Each fund, grouped by what it holds, with the fee it publishes, what it costs after securities-lending
        income, the verdict, and one line of reason
      </caption>
      <thead>
        <tr class="text-left">
          {COLUMNS.map((heading, i) => (
            <th scope="col" class:list={["label py-2 pr-3 font-semibold", (i === 1 || i === 2) && "text-right"]}>
              {heading}
            </th>
          ))}
        </tr>
      </thead>
      {groups.map((group) => (
        <tbody class="text-ink-2">
          <tr class="group-head">
            <th scope="colgroup" colspan={COLUMNS.length} class="h3 pt-10 pb-2 text-left">
              {group.label}
            </th>
          </tr>
          {group.rows.map(({ fund, verdict, note }) => (
            <tr class="align-top">
              <th scope="row" class="fund-cell py-2 pr-3 text-left font-normal">
                <span class="font-semibold text-ink">{fund.ticker}</span>
                <span class="fund-name text-sm leading-snug text-ink-3">{fund.name}</span>
              </th>
              <td data-label="Fee" data-numeric class="fee-cell py-2 pr-3 text-right">
                {pct(fund.expenseRatioBp)}
              </td>
              <td data-label="After lending" data-numeric class="cost-cell py-2 pr-3 text-right">
                {pct(fund.netCostBp)}
              </td>
              <td class="verdict-cell py-2 pr-3" data-verdict={verdict.toLowerCase().replace(/ /g, "-")}>
                {verdict}
              </td>
              <td class="why-cell py-2 text-sm text-ink-2">{note}</td>
            </tr>
          ))}
        </tbody>
      ))}
    </table>
  </div>

  <div class="prose mt-12">
    <Callout kind="caveat" label="Where this comes from">
      <p>
        Fees and lending income come from each fund's own annual filings. The buy-sell gap is the 30-day figure
        every exchange-traded fund has to publish. Which portfolios hold a fund is read from the portfolios
        themselves. Nothing here says whether a fund beat what its holdings alone would have paid; the data
        almost never answers that, and a column of such answers would read as a finding when it is mostly noise.
      </p>
    </Callout>
  </div>
</Base>

<style>
  /* Desktop: a plain table whose column headings stay in view while the groups scroll past. */
  .fund-table thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    background-color: var(--paper);
    border-bottom: 1px solid var(--rule-strong);
  }

  .fund-table tbody tr:not(.group-head) {
    border-bottom: 1px solid var(--rule);
  }

  .fund-table .group-head th {
    border-bottom: 1px solid var(--rule-strong);
  }

  .fund-name {
    display: block;
  }

  .fund-table .why-cell {
    max-width: 22rem;
  }

  .verdict-cell {
    white-space: nowrap;
    font-weight: 500;
    color: var(--ink);
  }

  .verdict-cell[data-verdict="held"] {
    font-weight: 600;
  }

  .verdict-cell[data-verdict="not-assessed"],
  .verdict-cell[data-verdict="rejected"] {
    color: var(--ink-2);
    font-weight: 400;
  }

  /* Phone: two lines per fund. Ticker and name with the verdict at the right; then the
     fee and the cost after lending with the one-line reason at the right. */
  @media (width < 48rem) {
    .fund-table,
    .fund-table tbody,
    .fund-table tbody tr,
    .fund-table tbody th,
    .fund-table tbody td {
      display: block;
      min-width: 0;
    }

    .fund-table thead {
      display: none;
    }

    /* The row is a wrapping flex line: fund and verdict on the first line, then a forced
       break (the row's own ::before, which a flex container treats as an item), then the
       fee, the cost and the reason flowing as one small line. */
    .fund-table tbody tr:not(.group-head) {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 0.6rem;
      row-gap: 0.1rem;
      padding: 0.6rem 0;
    }

    .fund-table tbody tr:not(.group-head)::before {
      content: "";
      order: 2;
      flex-basis: 100%;
      height: 0;
    }

    .fund-table .group-head th {
      display: block;
      padding-top: 2rem;
    }

    .fund-table .fund-cell {
      order: 0;
      flex: 1 1 0;
      min-width: 0;
      padding: 0;
    }

    .fund-name {
      display: inline;
      margin-left: 0.35rem;
    }

    .fund-table .verdict-cell {
      order: 1;
      flex: none;
      padding: 0;
      text-align: right;
    }

    .fund-table .fee-cell,
    .fund-table .cost-cell,
    .fund-table .why-cell {
      padding: 0;
      text-align: left;
      font-size: var(--text-xs);
      line-height: 1.45;
    }

    .fund-table .fee-cell {
      order: 3;
      flex: none;
      white-space: nowrap;
    }

    .fund-table .cost-cell {
      order: 4;
      flex: none;
      white-space: nowrap;
    }

    .fund-table .fee-cell::before,
    .fund-table .cost-cell::before {
      content: attr(data-label) " ";
      color: var(--ink-3);
    }

    .fund-table .cost-cell::after,
    .fund-table .fee-cell::after {
      content: " ·";
      color: var(--ink-3);
    }

    .fund-table .why-cell {
      order: 5;
      flex: 1 1 100%;
      min-width: 0;
      max-width: none;
    }

    .fund-table .cost-cell::after {
      content: none;
    }
  }
</style>
