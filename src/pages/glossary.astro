---
/**
 * Every word this site uses that a reader is not obliged to already have.
 *
 * `src/content/glossary.ts` is the canonical record for a term. This page prints each
 * one whole and unedited: the one-line answer, the paragraph behind it, why the word
 * is worth a reader's attention, and a link to the page that owns the fact.
 *
 * Alphabetical, because nobody reads a glossary. A reader arrives from a link on
 * another page wanting one entry, so every entry carries the same heading anchor
 * `slugifyHeading` gives a Markdown heading, and `/glossary/#tracking-error` is a
 * permanent address any other page may link straight at.
 */
import Callout from "~/components/Callout.astro";
import MarginNote from "~/components/MarginNote.astro";
import Rail from "~/components/Rail.astro";
import Base from "~/layouts/Base.astro";
import { glossary } from "~/content/glossary";
import { slugifyHeading } from "~/lib/anchors";
import { citationHref } from "~/lib/citation";

const entries = glossary
  .map((entry) => ({ ...entry, anchor: slugifyHeading(entry.term) }))
  .sort((a, b) => a.term.localeCompare(b.term, "en"));

const duplicate = entries.find((entry, i) => entries[i - 1]?.anchor === entry.anchor);
if (duplicate) {
  throw new Error(`Two glossary terms slug to #${duplicate.anchor}, so one of the two anchors is unreachable.`);
}
---

<Base
  title="Glossary"
  description="Every term this site leans on, defined in plain English: what it means, the paragraph behind it, and why it changes what you would do."
>
  <div class="prose">
    <Rail>Glossary</Rail>
    <h1 class="font-serif text-4xl tracking-[-0.02em] text-ink">Glossary</h1>

    <MarginNote label="Every entry has an address">
      <p>
        <code>/glossary/#tracking-error</code> opens this page at tracking error, and a link to a term from
        anywhere else on the site lands the same way.
      </p>
    </MarginNote>

    <p>
      The words this site leans on, written for somebody who is smart and does not work in finance. Each entry
      answers in one line, then explains, then says why the word would change what you do. A term is here because
      a page elsewhere rests on it.
    </p>
  </div>

  <nav id="terms" aria-label="Terms" data-pagefind-ignore class="mt-10 border-t border-rule pt-4 font-sans">
    <p class="eyebrow mb-2">The terms</p>
    <ul class="text-sm text-ink-muted sm:columns-2 sm:gap-8">
      {
        entries.map((entry) => (
          <li class="mb-1.5 break-inside-avoid">
            <a href={`#${entry.anchor}`} class="link">
              {entry.term}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    entries.map((entry) => (
      <section id={entry.anchor} class="prose mt-14 scroll-mt-8">
        <h2>{entry.term}</h2>

        <p>{entry.short}</p>

        {entry.source && (
          <MarginNote label="Where this is measured">
            <p>
              <a href={citationHref(entry.source)} class="link" rel="noopener noreferrer">
                {entry.source.label}
              </a>
            </p>
          </MarginNote>
        )}

        <p>{entry.long}</p>

        <Callout kind="mechanism" label="Why you care">
          <p>{entry.whyYouCare}</p>
        </Callout>

        <p class="font-sans text-sm">
          <a href="#terms" class="link">All terms</a>
        </p>
      </section>
    ))
  }
</Base>
