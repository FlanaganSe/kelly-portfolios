---
/**
 * The four portfolios side by side: one chart, one table, one chart of the falls, and
 * how to choose.
 *
 * Every cell is computed from the series the research emitter writes or from
 * `portfolios.ts`; nothing is typed. The table stacks into one card per row on a phone
 * (`.stack-table`), with each cell labelled by the portfolio it belongs to.
 */
import DrawdownChart from "~/components/DrawdownChart.astro";
import GrowthChart from "~/components/GrowthChart.astro";
import Hero from "~/components/Hero.astro";
import { PORTFOLIOS, type Portfolio } from "~/content/portfolios";
import Base from "~/layouts/Base.astro";
import { formatDollars, formatMonths, formatPct } from "~/lib/charts";
import { type EpisodeId, loadSeries, type PortfolioSeries, seriesFor, type YearReturn } from "~/lib/series";
import { monthLabel } from "~/lib/site";

const file = loadSeries();
const window = file.window.label;
const market = seriesFor("market");
const columns = PORTFOLIOS.map((p) => ({ portfolio: p, series: seriesFor(p.slug) }));
const withTrend = seriesFor("with-trend");
const cautious = seriesFor("cautious");

/** One clause each, in the same words as the card taglines' subjects. */
const FOR: Readonly<Record<Portfolio["slug"], string>> = {
  "one-fund": "Anyone; the default",
  "value-lean": "Someone who can watch a plain US index fund pull ahead for fifteen years",
  "with-trend": "Someone who can sit through a fall of about half and a decade of the trend fund adding nothing",
  cautious: "Someone who would sell after a fall of about 40%",
};

const dollars = (value: number) => formatDollars(value);
const yearCell = (y: YearReturn | null) => (y === null ? "—" : `${formatPct(y.pct, 1, true)} in ${y.year}`);
const episodeCell = (s: PortfolioSeries, id: EpisodeId) => {
  const value = s.summary.episodes[id];
  return value === null ? "—" : formatPct(value, 1, true);
};
const fallCell = (s: PortfolioSeries) =>
  `${dollars(s.summary.worstFall.dollarsAtTrough)} (${formatPct(s.summary.worstFall.pct)})`;

const ROWS: readonly { label: string; cells: readonly string[] }[] = [
  {
    label: "Funds",
    cells: columns.map((c) => c.portfolio.holdings.map((h) => `${h.ticker} ${h.weight}%`).join(", ")),
  },
  { label: "Fee a year on $10,000", cells: columns.map((c) => `${c.portfolio.feeOn10k} (${c.portfolio.fee})`) },
  { label: `$10,000 became, ${window}`, cells: columns.map((c) => dollars(c.series.summary.final)) },
  { label: "Worst fall, on $10,000 at the top", cells: columns.map((c) => fallCell(c.series)) },
  { label: "Months back to even", cells: columns.map((c) => formatMonths(c.series.summary.worstFall.monthsToRecover)) },
  { label: "Best year", cells: columns.map((c) => yearCell(c.series.summary.bestYear)) },
  { label: "Worst year", cells: columns.map((c) => yearCell(c.series.summary.worstYear)) },
  { label: "2008", cells: columns.map((c) => episodeCell(c.series, "gfc-2008")) },
  { label: "2022", cells: columns.map((c) => episodeCell(c.series, "rates-2022")) },
  { label: "Who it is for", cells: columns.map((c) => FOR[c.portfolio.slug]) },
];

// The long history, one paragraph: what $10,000 fell to across the 1929 crash. On that
// file every stock fund is the whole US market, so `one-fund` is US stocks.
type LongId = "one-fund" | "with-trend" | "cautious" | "sixty-forty";
const longFall = (id: LongId) => seriesFor(id, "1929").summary.worstFall;
const usStocks = longFall("one-fund");
const trendLong = longFall("with-trend");
const cautiousLong = longFall("cautious");
const sixtyFortyLong = longFall("sixty-forty");
const longFallText = (id: LongId) => {
  const fall = longFall(id);
  return `${formatDollars(fall.dollarsAtTrough)} (${formatPct(fall.pct)})`;
};
---

<Base
  title="Four portfolios, side by side"
  xl
  description="The four portfolios in one table: the funds, the cost a year, what $10,000 became, the worst fall in dollars, and whom each is for."
>
  <section class="wide">
    <Hero
      title="Four portfolios, side by side"
      lede={`Every number here is measured the same way: ${window}, against a plain world stock index. Pick by the fall you could sit through, then read the column.`}
    />
  </section>

  <div class="wide mt-10">
    <GrowthChart series={[market, ...columns.map((c) => c.series)]} title="What $10,000 became">
      Four portfolios and a plain world stock index, {window}, simulated from index data; the trend part is an index
      before trading costs. One fund and the plain index are the same mix here, so their lines overlap.
    </GrowthChart>
  </div>

  <section class="wide mt-14" aria-labelledby="table-heading">
    <h2 id="table-heading" class="h2">The four in one table</h2>
    <div class="compare-scroll mt-5">
      <table role="table" class="compare-table stack-table">
        <caption class="sr-only">
          The four portfolios compared on funds, fee, what $10,000 became, worst fall, months back to even, best
          and worst year, 2008, 2022 and whom each is for, {window}
        </caption>
        <thead role="rowgroup">
          <tr role="row">
            <td role="cell"></td>
            {
              columns.map((c) => (
                <th role="columnheader" scope="col">
                  <a href={c.portfolio.href} class="link">
                    {c.portfolio.name}
                  </a>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            ROWS.map((row) => (
              <tr role="row">
                <th role="rowheader" scope="row">
                  {row.label}
                </th>
                {row.cells.map((cell, i) => (
                  <td role="cell" data-label={columns[i]?.portfolio.name} data-numeric>
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <div class="wide mt-14">
    <DrawdownChart
      series={[cautious, withTrend]}
      highlight="cautious"
      worst={cautious.summary.worstFall}
      title="How far each fell from its last high"
    >
      Cautious against Plus trend, {window}: percent below the last high. Cautious never fell more than{" "}
      {formatPct(Math.abs(cautious.summary.worstFall.pct), 1)}; Plus trend fell{" "}
      {formatPct(Math.abs(withTrend.summary.worstFall.pct), 1)} between {monthLabel(withTrend.summary.worstFall.peak)}{" "}
      and {monthLabel(withTrend.summary.worstFall.trough)} and took{" "}
      {formatMonths(withTrend.summary.worstFall.monthsToRecover)} to get back.
    </DrawdownChart>
  </div>

  <div class="prose mt-14" id="choose">
    <h2>How to choose</h2>

    <p>
      Ask how far your money could fall before you would sell. One fund, Value lean and Plus trend each fell by
      about half at some point since 1990: $10,000 held at the top became{" "}
      {formatDollars(columns[0]?.series.summary.worstFall.dollarsAtTrough ?? 0)},{" "}
      {formatDollars(columns[1]?.series.summary.worstFall.dollarsAtTrough ?? 0)} and{" "}
      {formatDollars(columns[2]?.series.summary.worstFall.dollarsAtTrough ?? 0)}. Cautious fell to{" "}
      {formatDollars(cautious.summary.worstFall.dollarsAtTrough)}. If a fall of about half is more than you would
      hold through, Cautious is the one for you; the price is a slower climb, and its page says how much slower. If
      you could hold through it, the <a href="/#choose">home page</a> walks through the other three, and the
      simplest answer is One fund.
    </p>
  </div>

  <div class="prose mt-14">
    <h2>What these numbers are</h2>

    <p>
      These are simulated portfolios built from index data, not fund records. Each fund stands in as the mix of
      indexes it tracks, less its fee and a trading charge; the trend part is a vendor's trend index before its own
      trading costs, and RSST, the fund that supplies it, has existed only since September 2023; the bond part is a
      plain ten-year US government bond, because inflation-protected bonds have no history before 2003. Since 2009
      the trend part added about 0.4% a year, too little to tell from luck. The table and both charts cover
      November 1990 to May 2026, before tax. The paragraph below uses a second history, January 1929 to May 2025,
      on which every stock fund is the whole US market.
    </p>
  </div>

  <div class="prose mt-14">
    <h2>The long history</h2>

    <p>
      Across the 1929 crash, between {monthLabel(usStocks.peak)} and {monthLabel(usStocks.trough)}, $10,000 in US
      stocks fell to {longFallText("one-fund")} and took {formatMonths(usStocks.monthsToRecover)} to get back above
      $10,000. Plus trend fell to {longFallText("with-trend")} and took {formatMonths(trendLong.monthsToRecover)}. A
      plain 60/40 mix, 60% stocks and 40% US government bonds, fell to {longFallText("sixty-forty")} and took{" "}
      {formatMonths(sixtyFortyLong.monthsToRecover)}. Cautious fell to {longFallText("cautious")} and took{" "}
      {formatMonths(cautiousLong.monthsToRecover)}. Nothing on this site would have held a 30% fall through those
      years, so the labels above rest on the history since 1990, not on that one. All of it is simulated: nobody earned these returns,
      and nobody sat through the falls without knowing how they ended.
    </p>
  </div>
</Base>

<style>
  /* The table runs the full track and scrolls inside its own box if it must; the page
     never scrolls sideways. Below 40rem `.stack-table` turns each row into a card. */
  .compare-scroll {
    overflow-x: auto;
    max-width: 100%;
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .compare-table thead th,
  .compare-table thead td {
    padding: 0 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--rule-strong);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 600;
    text-align: left;
    vertical-align: bottom;
  }

  .compare-table tbody th,
  .compare-table tbody td {
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .compare-table tbody th {
    font-weight: 600;
    color: var(--ink);
    width: 11rem;
  }

  .compare-table tbody td {
    color: var(--ink-2);
  }

  @media (width >= 40rem) {
    .compare-table tbody td {
      width: 20%;
    }
  }
</style>
