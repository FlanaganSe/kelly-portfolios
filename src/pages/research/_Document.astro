---
/**
 * The shell every rendered corpus page uses: header, contents, body, structured data.
 *
 * Underscore-prefixed, so Astro treats it as a private module rather than a route. It
 * lives here rather than in `src/components/` because nothing outside this directory
 * renders a research document, and the styles below are scoped to `.research-body` for
 * the same reason: they exist to make one specific kind of Markdown readable, not to
 * become another house style.
 *
 * The body arrives as a slot holding `<Content />`. Its links were rewritten and its
 * tables wrapped in `src/content.config.ts`, on the way into the data store, so the
 * Markdown under `docs/` stays research notes rather than becoming web pages.
 */
import type { MarkdownHeading } from "astro";
import Rail from "~/components/Rail.astro";
import { StatusChip } from "~/components/StatusChip";
import type { EvidenceStatus } from "~/content/types";
import Base from "~/layouts/Base.astro";
import { REPO_BLOB_BASE } from "~/lib/citation";
import type { PlainPage } from "~/lib/research";
import { canonicalPath, SITE_NAME } from "~/lib/site";

interface Crumb {
  readonly name: string;
  readonly href: string;
}

interface Props {
  title: string;
  description: string;
  /** The word in the left rail, and the word the header uses for this kind of page. */
  rail: string;
  /** Repository-relative, e.g. `docs/research/long-only-capture.md`. */
  docPath: string;
  updated?: string | undefined;
  status?: EvidenceStatus | undefined;
  /** The reader-facing page covering the same ground without the vocabulary. */
  plain?: PlainPage | undefined;
  /** The question the group this page belongs to answers. */
  question?: string | undefined;
  headings: readonly MarkdownHeading[];
  crumbs: readonly Crumb[];
}

const { title, description, rail, docPath, updated, status, plain, question, headings, crumbs } = Astro.props;

// Only the top level. A contents list that mirrors every subheading of a twelve-section
// page is a second page rather than a way into the first one.
const sections = headings.filter((heading) => heading.depth === 2);

// The document's own `# ` line is this page's `h1`, and the loader strips it from the
// body so the page has one. Its id has to move with it: `#the-title` is a real anchor
// in the corpus and several pages link to their own top.
const topAnchor = headings.find((heading) => heading.depth === 1)?.slug;

const origin = Astro.site ?? new URL("https://kellyportfolios.com");
const canonical = new URL(canonicalPath(Astro.url.pathname), origin).href;

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: "en",
  ...(updated ? { dateModified: updated } : {}),
  author: { "@type": "Organization", name: SITE_NAME, url: origin.href },
  publisher: { "@type": "Organization", name: SITE_NAME, url: origin.href },
  isPartOf: { "@type": "WebSite", name: SITE_NAME, url: origin.href },
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: crumb.name,
    item: new URL(crumb.href, origin).href,
  })),
};
---

<Base title={title} description={description}>
  <div class="prose">
    <Rail>{rail}</Rail>

    <nav aria-label="Breadcrumb" class="mb-4 font-sans text-sm text-ink-faint">
      <ol class="flex flex-wrap items-baseline gap-x-2">
        {
          crumbs.map((crumb, index) => (
            <li class="flex items-baseline gap-x-2">
              {index > 0 && <span aria-hidden="true">/</span>}
              {index === crumbs.length - 1 ? (
                <span aria-current="page">{crumb.name}</span>
              ) : (
                <a href={crumb.href} class="link">
                  {crumb.name}
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </nav>

    <h1 id={topAnchor} class="font-serif text-4xl tracking-[-0.02em] text-ink">{title}</h1>

    <p class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-2 font-sans text-sm text-ink-muted">
      {status && <StatusChip status={status} />}
      {updated && <span data-numeric>Last changed {updated}</span>}
      <a href={`${REPO_BLOB_BASE}/${docPath}`} rel="noopener noreferrer" class="link font-mono text-xs">{docPath}</a>
    </p>

    <aside class="mt-6 border-l-2 border-rule-strong pl-4 font-sans text-sm text-ink-muted [&>*+*]:mt-2">
      <p class="eyebrow">Who this is for</p>
      <p>
        A working note from the repository, printed as it was written. It keeps the vocabulary, the tables and the
        caveats of the original, and nothing in it has been softened for a general reader.
      </p>
      {
        plain && (
          <p>
            The plain-English page over the same ground is <a href={plain.href} class="link">{plain.label}</a>.
          </p>
        )
      }
      {question && <p>Part of the group that answers: {question}.</p>}
    </aside>

    {
      sections.length >= 4 && (
        <nav aria-label="Contents" data-pagefind-ignore class="mt-8 border-t border-rule pt-4 font-sans">
          <p class="eyebrow mb-2">Contents</p>
          <ol class="text-sm text-ink-muted sm:columns-2 sm:gap-8">
            {sections.map((section) => (
              <li class="mb-1.5 break-inside-avoid">
                <a href={`#${section.slug}`} class="link">
                  {section.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>

  <div class="prose research-body mt-10">
    <slot />
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(article)} is:inline />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} is:inline />
</Base>

<style is:global>
  /* Scoped to the rendered corpus. `prose` styles a hand-written page; these fill in
     what Markdown emits that no hand-written page here uses: tables, code blocks and
     headings below the third level. */

  .research-body h4,
  .research-body h5,
  .research-body h6 {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.01em;
    margin-top: 1.8em;
    margin-bottom: -0.55em;
    color: var(--ink-muted);
  }

  /* The scroller is the wrapper the loader puts around every table, so the overflow
     belongs to a box the width of the reading column and never to the document. At
     390px the page still does not move sideways; the table does. */
  .research-body .research-table {
    margin-block: 1.6em;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  /* On a wide screen the reading measure is narrower than the body track, and the
     margin track beside it is empty on these pages. A nine-column table is allowed
     both, which is the difference between reading it and scrolling it. Below 62rem
     the margin track is zero wide and this is the reading column again. */
  @media (min-width: 62rem) {
    .research-body .research-table {
      width: calc(100% + var(--note-gap) + var(--note));
    }
  }

  .research-body table {
    /* Natural width, floored at the column, so a narrow table fills the measure and a
       nine-column one keeps its shape and scrolls. */
    width: max-content;
    min-width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .research-body th,
  .research-body td {
    /* A cap rather than a fixed width: a cell of prose wraps, a cell of digits does
       not, and neither drags the table out to the width of its longest sentence. */
    max-width: 24rem;
    padding: 0.5rem 1.1rem 0.5rem 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--rule);
  }

  .research-body tbody tr:last-child td {
    border-bottom: 0;
  }

  .research-body thead th {
    border-bottom: 1px solid var(--rule-strong);
    font-weight: 600;
    color: var(--ink);
  }

  .research-body td code,
  .research-body th code {
    font-size: 0.8em;
  }

  /* `research/tests/unit/test_studies_investor_placement.py` has no space in it and no
     break opportunity either, so at 390px it reached 144px past the viewport and took
     the page with it. The table scrollers were never the problem; a file path in a
     sentence was. */
  .research-body :not(pre) > code {
    overflow-wrap: anywhere;
  }

  .research-body {
    overflow-wrap: break-word;
  }

  .research-body pre {
    overflow-x: auto;
    background-color: var(--paper-sunken);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 0.9rem 1rem;
    font-size: var(--text-sm);
  }

  .research-body pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }

  .research-body blockquote {
    font-size: var(--text-base);
  }

  /* A footnote list, and any list of sources at the foot of a page. */
  .research-body sup a {
    text-decoration: none;
  }
</style>
