---
/**
 * One synthesis from `docs/research/`, rendered on this site.
 *
 * The route keeps the bare filename stem, because that is what every figure citation
 * and every cross-link in the corpus already spells. The page's own `# ` line is its
 * title and its first paragraph is the description; neither is copied into a
 * frontmatter block that would then drift from the document.
 */
import { getCollection, render } from "astro:content";
import { researchGroupOf, researchLead, researchMeta, researchTitle } from "~/lib/research";
import Document from "./_Document.astro";

export async function getStaticPaths() {
  const entries = await getCollection("research", (entry) => entry.data.draft !== true);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const title = researchTitle(entry);
const lead = researchLead(entry);
const meta = researchMeta(entry.id);
const group = researchGroupOf(entry.id);

// Long enough to be useful in a search result, short enough that no engine truncates
// mid-clause. The lead is the document's own opening paragraph.
const description = lead ? `${lead.slice(0, 180).trim()}${lead.length > 180 ? "…" : ""}` : title;
---

<Document
  title={title}
  description={description}
  rail="Research"
  docPath={`docs/research/${entry.id}.md`}
  updated={entry.data.updated}
  status={entry.data.status ?? meta?.status}
  plain={meta?.plain}
  question={group?.question}
  headings={headings}
  crumbs={[
    { name: "Kelly Portfolios", href: "/" },
    { name: "Research", href: "/research/" },
    { name: title, href: `/research/${entry.id}/` },
  ]}
>
  <Content />
</Document>
