---
/**
 * Search, using Pagefind's own web components rather than the integration's
 * `Search.astro` wrapper, which upstream has marked as maintenance-only.
 *
 * The index is built from every `data-pagefind-body` on the site, which is the page's
 * `<main>` and not its masthead — otherwise every query would match every page on the
 * navigation alone. This page opts itself out: it has no words worth finding.
 */
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import Base from "~/layouts/Base.astro";
---

<Base
  title="Search"
  description="Search every page on this site: the portfolios, the strategies, the funds and how to hold them."
  indexable={false}
  asOf={null}
>
  <PagefindConfig />

  <h1 class="font-serif text-3xl tracking-[-0.02em] text-ink">Search</h1>
  <p class="mt-3 max-w-measure text-ink-muted">Every page on the site, including the ideas that did not work.</p>

  <div class="mt-8" data-pagefind-ignore>
    <pagefind-searchbox></pagefind-searchbox>
  </div>

  <noscript>
    <p class="mt-8 max-w-measure text-ink-muted">
      Search needs JavaScript, and it is the only page here that does. Every other page is plain HTML, so the
      <a class="link" href="/">home page</a> and the links above work without it.
    </p>
  </noscript>
</Base>

<style is:global>
  /* Pagefind's component ships its own custom properties. Point them at the site's
     tokens so the widget inherits the theme instead of arriving with its own. */
  pagefind-searchbox {
    --pagefind-ui-primary: var(--ink);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--rule-strong);
    --pagefind-ui-tag: var(--paper-sunken);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-font: var(--font-sans);
    display: block;
    max-width: var(--container-measure);
  }
</style>
