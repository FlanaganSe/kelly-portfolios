---
/**
 * The two calculators, and what each one answers.
 *
 * Short on purpose. A landing page for two links should not delay the reader who came
 * here to use one of them, so the headline figure each tool produces is on the card and
 * the argument lives on the tool's own page.
 */
import Rail from "~/components/Rail.astro";
import Base from "~/layouts/Base.astro";
import { timeToKnow } from "~/components/islands/horizon-model";
import { horizonPresets } from "~/components/islands/horizon-presets";
import { bp, queue, shelf } from "~/components/islands/placement-model";
import { defaultTaxRegime, placementAsOf } from "~/content/placement";
import { confidenceAsOf } from "~/content/confidence";
import { formatYears } from "~/lib/format";

const opening = queue(shelf("paid-out"), defaultTaxRegime);
const top = opening[0];
const last = opening[opening.length - 1];

const fees = horizonPresets[0];
const whole = horizonPresets[2];
const waitFor = (preset: (typeof horizonPresets)[number]) => {
  const outcome = timeToKnow({ edgeBp: preset.edgeBp, trackingErrorBp: preset.trackingErrorBp, confidence: 0.9 });
  return outcome.kind === "years" ? formatYears(outcome.years) : "no horizon at all";
};

const cards = [
  {
    href: "/tools/placement/",
    title: "Where to hold each fund",
    blurb:
      "Your bracket and your account split, in. The order to fill your Roth and your 401(k) in, out. The answer inverts the advice you have read everywhere else.",
    figure: `${top?.ticker} first at ${bp(top?.priorityBp ?? 0)} bp, ${last?.ticker} last at ${bp(last?.priorityBp ?? 0)} bp`,
    asOf: placementAsOf,
  },
  {
    href: "/tools/how-long/",
    title: "How long before you would know",
    blurb:
      "How much better you expect to do, and how far it can wander getting there. Out comes the number of years before your own account could tell you it worked.",
    figure: `Fees settle in ${waitFor(fees as (typeof horizonPresets)[number])}. The whole portfolio takes ${waitFor(whole as (typeof horizonPresets)[number])}.`,
    asOf: confidenceAsOf,
  },
];
---

<Base
  title="Tools"
  description="Two calculators that run in your browser: which account each fund belongs in at your own tax rates, and how many years pass before your own account could tell you a choice worked."
>
  <div class="prose">
    <Rail>Tools</Rail>
    <h1 class="font-serif text-4xl tracking-[-0.02em] text-ink">Tools</h1>

    <p>Two calculators. Both run entirely in your browser, both are driven by the same code the research pages
    are, and neither sends anything anywhere.</p>
  </div>

  <ul class="mt-10 space-y-6">
    {
      cards.map((card) => (
        <li class="border-t border-rule pt-5">
          <h2 class="font-sans text-xl font-semibold tracking-[-0.015em]">
            <a class="link text-ink" href={card.href}>{card.title}</a>
          </h2>
          <p class="mt-2 max-w-measure text-ink-muted">{card.blurb}</p>
          <p data-numeric class="mt-2 text-sm text-ink-faint">
            {card.figure} · as of {card.asOf}
          </p>
        </li>
      ))
    }
  </ul>
</Base>
