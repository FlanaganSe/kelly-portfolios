---
/**
 * The not-found page.
 *
 * The host serves `dist/404.html` for any path it cannot resolve, so this file is the
 * whole mechanism. It stays out of the search index and out of search results: a 404
 * that ranks is worse than no 404.
 */
import Base from "~/layouts/Base.astro";
import { NAV_ITEMS } from "~/lib/site";
---

<Base
  title="That page is not here"
  description="The page you asked for does not exist on this site."
  indexable={false}
  noindex
  asOf={null}
>
  <p class="eyebrow">404</p>
  <h1 class="mt-2 font-serif text-4xl tracking-[-0.02em] text-ink">That page is not here</h1>

  <div class="prose mt-6">
    <p>The address may have a typo in it, or the page has moved. Everything on the site is one click from here.</p>
  </div>

  <nav aria-label="Everything on the site" class="mt-8">
    <p class="label">Try one of these</p>
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
      <li><a href="/" class="link">Home</a></li>
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href} class="link">
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href="/search/" class="link">Search</a></li>
    </ul>
  </nav>
</Base>
