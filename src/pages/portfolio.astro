---
/**
 * The concrete construction: seven funds, the account each goes in, and the one choice
 * left to the reader.
 *
 * Both horizons quoted here are `T = (z·s/e)²` at 90% confidence, so they answer when
 * the reader's own account would show the gap. The design's detection horizon — 59
 * years — is a different estimand and lives only on `/how-sure/`.
 */
import Breakout from "~/components/Breakout.astro";
import Callout from "~/components/Callout.astro";
import Figure from "~/components/Figure.astro";
import MarginNote from "~/components/MarginNote.astro";
import Rail from "~/components/Rail.astro";
import Rung from "~/components/Rung.astro";
import Base from "~/layouts/Base.astro";
---

