---
/**
 * Every idea people add to a portfolio, with its verdict, one sentence and one number,
 * grouped by verdict. The detail lives on the page each card links to; this page only
 * says which word each idea earned and why in twenty words.
 *
 * Numbers that describe what a portfolio did come from the series the research emitter
 * writes; the rest are read from figure records. Nothing here is typed from memory.
 */
import Hero from "~/components/Hero.astro";
import VerdictCard from "~/components/VerdictCard.astro";
import VerdictGroup from "~/components/VerdictGroup.astro";
import Base from "~/layouts/Base.astro";
import { formatPct } from "~/lib/charts";
import { figureValue } from "~/lib/figures";
import type { Verdict } from "~/lib/rungs";
import { loadSeries, seriesFor } from "~/lib/series";

const file = loadSeries("1990");
const long = loadSeries("1929");
const market = seriesFor("market").summary;
const valueLean = seriesFor("value-lean").summary;
const cautious = seriesFor("cautious").summary;
const longTrend = seriesFor("with-trend", "1929").summary;
const longMarket = seriesFor("market", "1929").summary;

interface Card {
  title: string;
  verdict: Verdict;
  sentence: string;
  number?: string;
  numberLabel?: string;
  href: string;
  more?: string;
}

const held: Card[] = [
  {
    title: "Leaning toward cheaper companies",
    verdict: "Probably",
    sentence:
      "Beat a plain world index by a little since 1990, and again on 1980s data the funds never saw. Needs decades of patience.",
    number: `${formatPct(valueLean.cagrPct)} a year`,
    numberLabel: `against ${formatPct(market.cagrPct)} for a plain world stock index, ${file.window.label}, simulated`,
    href: "/portfolios/value-lean/",
  },
  {
    title: "Trend following on top of stocks",
    verdict: "Too close to call",
    sentence:
      "The strongest candidate on a century of index data, most of it before 2009, delivered by a fund under three years old.",
    number: `${formatPct(longTrend.cagrPct)} a year`,
    numberLabel: `Plus trend against ${formatPct(longMarket.cagrPct)} for all US stocks, ${long.window.label}, simulated`,
    href: "/portfolios/with-trend/",
  },
  {
    title: "Inflation-protected bonds, for a smaller fall",
    verdict: "Settled",
    sentence:
      "Fewer stocks means a smaller fall; that part is arithmetic. Whether the bonds add any return is too close to call.",
    number: formatPct(cautious.worstFall.pct),
    numberLabel: `worst fall of the cautious portfolio against ${formatPct(market.worstFall.pct)} for a plain world stock index, ${file.window.label}`,
    href: "/portfolios/cautious/",
  },
  {
    title: "Foreign stocks",
    verdict: "Probably",
    sentence:
      "A 65/35 US/foreign split is roughly the world market. Foreign stocks are cheaper, and most of the US lead was rising prices.",
    number: "81%",
    numberLabel: "of the US lead over 35 years came from US stocks getting dearer, 1990 to 2024",
    href: "/strategies/international/",
  },
];

const close: Card[] = [
  {
    title: "Gold",
    verdict: "Too close to call",
    sentence:
      "Does the job of cash in a fall, with big swings instead of none. Adds no return the tests can see.",
    number: `${await figureValue("gold-over-cash")} a year over cash`,
    numberLabel: "1975 to mid-2026, after storage costs",
    href: "/strategies/gold-and-bitcoin/",
  },
  {
    title: "Catastrophe bonds",
    verdict: "Too close to call",
    sentence:
      "The one holding whose losses come from hurricanes rather than markets. The funds earned about 1% a year over cash, and the price is the thinnest on record.",
    number: await figureValue("cat-bond-spread-multiple"),
    numberLabel: "the expected loss, mid-2026; the question reopens at 3.5 times",
    href: "/strategies/crash-protection/",
  },
  {
    title: "Cash",
    verdict: "Too close to call",
    sentence:
      "Moving 10% of stocks into cash-like government bills added as much back in the worst months as gold did, for no fee.",
    number: "+0.92%",
    numberLabel: "added back in the average worst stock month since 1926",
    href: "/strategies/crash-protection/",
  },
  {
    title: "Carry, a second futures strategy",
    verdict: "Too close to call",
    sentence:
      "Moves independently of trend and added about 0.2% a year after costs on paper. Negative since 2013; the fund is two years old.",
    number: "−0.88% a year",
    numberLabel: "the fund since launch, against 18.9% for the S&P 500",
    href: "/strategies/stacking/",
  },
  {
    title: "Rebalancing",
    verdict: "Too close to call",
    sentence:
      "Keeps your mix from drifting, which is the point. As a source of return it came out a hair behind never trading.",
    number: `${await figureValue("rebalance-return")} a year`,
    numberLabel: "a yearly review against never trading, inside a range the test could not read",
    href: "/how-to-hold/",
  },
];

