  },
  {
    title: "Property funds",
    verdict: "No",
    sentence: "Property funds gave 112% of the market's falls for 80% of its rises. Stocks by another name.",
    number: "0.82 out of 1",
    numberLabel: "how closely a property fund moves with the whole market",
    href: "/strategies/crash-protection/",
  },
  {
    title: "Direct indexing",
    verdict: "No",
    sentence:
      "Owning an index's stocks one by one to harvest tax losses cost money on every one of 400 simulated thirty-year paths.",
    number: await figureValue("harvest-losses-used"),
    numberLabel: "of the losses it harvests ever save tax for someone who never sells",
    href: "/how-to-hold/",
  },
];

const unmeasured: Card[] = [
  {
    title: "Covered-call and income funds",
    verdict: "Not measured yet",
    sentence:
      "They sell the market's upside each month for cash, the mirror image of buying crash insurance. No whole-portfolio test has been run.",
    href: "/strategies/crash-protection/",
  },
  {
    title: "Target-date funds",
    verdict: "Not measured yet",
    sentence:
      "The one-fund portfolio plus bonds on a schedule set by your age. The bond share here is set by the fall you can sit through instead.",
    href: "/portfolios/cautious/",
  },
  {
    title: "Sector bets",
    verdict: "Not measured yet",
    sentence:
      "Nothing here separates a sector from the market it sits in. About half the US market's lead over the world is its larger tech sector.",
    href: "/strategies/international/",
  },
  {
    title: "Thematic funds",
    verdict: "Not measured yet",
    sentence:
      "A themed fund is a bet on one story. The nearest thing tested, an AI stock-picking fund, returned about half the S&P 500 since 2017.",
    href: "/portfolios/one-fund/",
  },
  {
    title: "Single stocks",
    verdict: "Not measured yet",
    sentence:
      "The one form tested, owning an index's stocks one by one to harvest losses, lost money on every one of 400 paths.",
    href: "/portfolios/one-fund/",
  },
  {
    title: "Risk-parity and all-weather funds",
    verdict: "Not measured yet",
    sentence:
      "Each part, long bonds, gold and commodities, was measured alone and none beat plain cash in the worst stock months. The fund itself was not.",
    href: "/strategies/crash-protection/",
  },
  {
    title: "Equal-weight index funds",
    verdict: "Not measured yet",
    sentence:
      "Mostly the lean toward smaller companies this site already holds, in a dearer form. Not tested as a holding.",
    href: "/portfolios/value-lean/",
  },
  {
    title: "TIPS ladders and I-bonds",
    verdict: "Not measured yet",
    sentence:
      "The same inflation-protected bonds in a different form. A ladder suits a dated spend; I-bonds are capped at $10,000 a year.",
    href: "/portfolios/cautious/",
  },
  {
    title: "Bonds with trend on top",
    verdict: "Not measured yet",
    sentence:
      "A fund that stacks trend following on bonds instead of stocks, inside the cautious portfolio. The next thing to be measured.",
    href: "/portfolios/cautious/",
  },
  {
    title: "A cheaper stacked fund plus a trend fund",
    verdict: "Not measured yet",
    sentence:
      "About a third the cost of RSST per dollar of trend, but it pays for the trend by selling stocks, the funding that has not worked.",
    href: "/portfolios/with-trend/",
  },
  {
    title: "Bonds with the interest-rate risk hedged out",
    verdict: "Not measured yet",
    sentence:
      "On 1926 to 2014 the idea was the one bond-like bet that did not move with government bonds. The funds are twelve years old.",
    href: "/strategies/crash-protection/",
  },
  {
    title: "Foreign or emerging-market trend funds",
    verdict: "Not measured yet",
    sentence: "No fund isolates them, and the trend fund held already trades fifty-plus markets worldwide.",
    href: "/portfolios/with-trend/",
  },
  {
    title: "The 200-day rule on the trend fund only",
    verdict: "Not measured yet",
    sentence:
      "The rule was measured on the stock holding, where it halved the worst fall and could not be shown to add return.",
    href: "/strategies/market-timing/",
  },
  {
    title: "Merger arbitrage and hedge-fund copies",
    verdict: "Not measured yet",
    sentence:
      "Ten-year returns of 2.9% to 4.3% a year in a decade whose cash rate was most of that. Too small to be worth resolving.",
    href: "/strategies/stacking/",
  },
  {
    title: "Hedged foreign bond funds",
    verdict: "Not measured yet",
    sentence:
      "Close to a US bond fund with a currency hedge attached. Emerging-market bonds carry the currencies that fall hardest in a crisis.",
    href: "/strategies/crash-protection/",
  },
  {
    title: "Ether and other coins",
    verdict: "Not measured yet",
    sentence:
      "Staking pays about 1.3% to 1.9% a year before a fee that can exceed it, on an asset that fell 67% from its 2025 high.",
