  { label: "All of it into the single best of the four, funded by selling", figure: "substitution-best" },
  { label: "All four as actually weighted, funded by selling", figure: "candidate-as-weighted" },
  { label: "All four financed on top of what you already own", figure: "financed-overlay" },
