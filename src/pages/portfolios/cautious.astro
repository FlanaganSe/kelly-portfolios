---
/**
 * Portfolio four: half the money in inflation-protected government bonds and the rest in
 * the Plus trend portfolio's funds, for someone who would sell after a fall of about 40%.
 * One version. The one built for a 30% fall gets one sentence, with its two worst falls
 * read from its own series.
 */
import Button from "~/components/Button.astro";
import Callout from "~/components/Callout.astro";
import Donut from "~/components/Donut.astro";
import DrawdownChart from "~/components/DrawdownChart.astro";
import GrowthChart from "~/components/GrowthChart.astro";
import Hero from "~/components/Hero.astro";
import StatGrid from "~/components/StatGrid.astro";
import Verdict from "~/components/Verdict.astro";
import { CAUTIOUS_30_HOLDINGS, portfolio } from "~/content/portfolios";
import { fundByTicker } from "~/content/shelf";
import { formatDollars, formatMonths, formatPct } from "~/lib/charts";
import { loadSeries, seriesFor } from "~/lib/series";
import Base from "~/layouts/Base.astro";

const p = portfolio("cautious");
const file = loadSeries("1990");
const own = seriesFor("cautious");
const before = seriesFor("with-trend");
const market = seriesFor("market");
const sixtyForty = seriesFor("sixty-forty");
const thirty = seriesFor("cautious-30");
const long = seriesFor("cautious", "1929");
const longMarket = seriesFor("market", "1929");
const longBefore = seriesFor("with-trend", "1929");
const longThirty = seriesFor("cautious-30", "1929");

const s = own.summary;
const m = market.summary;
const fall = s.worstFall;

const MONTHS = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
/** `2007-10` as "October 2007". */
function monthName(date: string): string {
  const [year, month] = date.split("-");
  return `${MONTHS[Number(month) - 1]} ${year}`;
}
const pct = (value: number) => formatPct(Math.abs(value), 1);
const yearOf = (date: string) => date.slice(0, 4);

const weightOf = (ticker: string) => {
  const found = CAUTIOUS_30_HOLDINGS.find((h) => h.ticker === ticker);
  if (found === undefined) throw new Error(`No ${ticker} in the 30% construction`);
  return found.weight;
};
const thirtyStocks = CAUTIOUS_30_HOLDINGS.filter((h) => h.ticker !== "SCHP" && h.ticker !== "RSST").reduce(
  (sum, h) => sum + h.weight,
  0
);

/** The six-word column and the account column, in the order the holdings are printed. */
const ROWS: Record<string, { name: string; holds: string; account: string }> = {
  SCHP: {
    name: "Schwab U.S. TIPS ETF",
    holds: "Inflation-protected US government bonds",
    account: "Pre-tax retirement account, then Roth, taxable last",
  },
  RSST: {
    name: "Return Stacked U.S. Stocks & Managed Futures ETF",
    holds: "US stocks plus a trend-following strategy",
    account: "Pre-tax retirement account, before SCHP",
  },
  VTI: { name: "Vanguard Total Stock Market ETF", holds: "The whole US stock market", account: "Taxable account" },
  VXUS: {
    name: "Vanguard Total International Stock ETF",
    holds: "Every stock market outside the US",
    account: "Retirement account",
  },
  VTV: { name: "Vanguard Value ETF", holds: "Large US companies priced cheaply", account: "Either" },
  AVDV: {
    name: "Avantis International Small Cap Value ETF",
    holds: "Small, cheap, profitable foreign companies",
    account: "Retirement account",
  },
  IDMO: {
    name: "Invesco S&P International Developed Momentum ETF",
    holds: "Foreign companies whose shares are rising",
    account: "Retirement account",
  },
  AVES: {
    name: "Avantis Emerging Markets Value ETF",
    holds: "Cheap companies in emerging markets",
    account: "Retirement account",
  },
};

const holdings = p.holdings.map((h) => {
  const row = ROWS[h.ticker];
  if (row === undefined) throw new Error(`No table row for ${h.ticker}`);
  const bp = fundByTicker(h.ticker).expenseRatioBp;
  if (bp === null) throw new Error(`${h.ticker} has no expense ratio`);
  return { ...h, ...row, feeOn10k: formatDollars(bp, "exact"), label: row.holds };
});

const STATS = [
  { value: formatDollars(s.final), label: "$10,000 became", note: `${file.window.label}, simulated` },
  {
    value: `${formatPct(s.cagrPct)} a year`,
    label: "Growth",
    note: `Against ${formatPct(m.cagrPct)} for a plain world stock index`,
  },
  {
    value: formatPct(fall.pct),
    unit: formatDollars(fall.dollarsAtTrough),
    label: "Worst fall",
    note: `${monthName(fall.peak)} to ${monthName(fall.trough)}, back to even in ${formatMonths(fall.monthsToRecover)}`,
  },
  { value: p.feeOn10k, label: "Costs a year on $10,000", note: `${p.fee} fee, most of it RSST's 0.99%` },
];
---

<Base
  title="Cautious"
  description="Half the money in inflation-protected US government bonds and the rest in the Plus trend portfolio's funds, for someone who would sell after a fall of about 40%. What $10,000 did since 1990, the worst fall in dollars, what it gives up, and how to hold it."
  xl
>
  <Hero
    eyebrow="Portfolio 4 of 4"
    title="Cautious"
    lede="Half the money in inflation-protected US government bonds and the rest in the Plus trend portfolio's funds, for someone who would sell after a fall of about 40%."
  >
    <p class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-ink-2">
      <Verdict word="Too close to call" gloss="The smaller fall is measured. Whether the trend fund and the lean earn their fees inside it is not." />
    </p>
  </Hero>

  <div class="prose mt-10">
    <h2 id="what-you-buy">What you buy</h2>
    <p>The same eight funds as Plus trend, in different amounts. Half is SCHP, a fund of inflation-protected US
    government bonds, whose value rises with prices. The six stock funds hold 35% together, in the same
    proportions as Plus trend. RSST holds another 15% and gives a dollar of US stocks plus a dollar of a
    trend-following strategy, one that buys what is rising and bets against what is falling, for each dollar in
    it. So about half the portfolio is stocks, 15% is trend, and half is bonds. It costs {p.fee} a year,
    {p.feeOn10k} on $10,000.</p>
  </div>

  <div class="wide mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
    <div class="overflow-x-auto" tabindex="0" aria-label="What the portfolio holds">
      <table class="holdings w-full min-w-[40rem] border-collapse text-base">
        <caption class="sr-only">Each fund, what it holds, its share, its fee on $10,000 and the account to hold it in</caption>
        <thead>
          <tr class="border-b border-rule-strong text-left">
            <th scope="col" class="label py-2 pr-3 font-semibold">Fund</th>
            <th scope="col" class="label py-2 pr-3 font-semibold">What it holds</th>
            <th scope="col" class="label py-2 pr-3 text-right font-semibold">Share</th>
            <th scope="col" class="label py-2 pr-3 text-right font-semibold">Fee on $10,000</th>
            <th scope="col" class="label py-2 font-semibold">Account</th>
          </tr>
        </thead>
        <tbody class="text-ink-2">
          {holdings.map((h) => (
            <tr class="border-b border-rule align-top last:border-0">
              <th scope="row" class="py-2 pr-3 text-left font-medium text-ink">
                {h.ticker}
                <span class="block text-sm font-normal text-ink-3">{h.name}</span>
              </th>
              <td class="py-2 pr-3">{h.holds}</td>
              <td data-numeric class="py-2 pr-3 text-right whitespace-nowrap">{h.weight}%</td>
              <td data-numeric class="py-2 pr-3 text-right whitespace-nowrap">{h.feeOn10k}</td>
              <td class="py-2">{h.account}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Donut holdings={holdings} name="Cautious" center={{ value: p.fee, label: "a year" }} />
  </div>

  <div class="prose">
    <Callout kind="do-this">
      <p>Hold RSST in a pre-tax retirement account, a traditional IRA or 401(k), or do not hold it. Its trend
      profits are taxed like wages, and most of them have not been paid out yet, so in a taxable account a
      large bill is possible in any year.</p>
    </Callout>
  </div>

  <div class="prose w-full mt-14">
    <h2 id="what-10000-did">What $10,000 did</h2>
  </div>

  <StatGrid items={STATS} class="wide mt-6" />

  <GrowthChart series={[market, before, own]} highlight="cautious" title="What $10,000 became" class="wide mt-10">
    Cautious, Plus trend and a plain world stock index, {file.window.label}. These are simulated portfolios
    built from index data, not fund records: each fund is stood in for by the indexes it tracks, less its fee
    and a trading cost; the trend part is a trend index before its own trading costs; SCHP is a plain ten-year
    US government bond, because inflation-protected bonds did not exist before 2003; RSST has existed only
    since September 2023; and since 2009 the trend part added about 0.4% a year, too little to tell from luck.
  </GrowthChart>

  <div class="prose mt-8">
    <p>Over {file.window.label}, $10,000 became {formatDollars(s.final)} here against {formatDollars(m.final)} in the plain index and {formatDollars(sixtyForty.summary.final)} in a
    60/40 mix, 60% stocks and 40% US government bonds. Since 2009 it grew {formatPct(s.since2009?.cagrPct ?? Number.NaN)} a
    year against {formatPct(m.since2009?.cagrPct ?? Number.NaN)} for the index: a bond-heavy mix lags badly through
    a long stock bull market.</p>
  </div>

  <div class="prose w-full mt-14">
    <h2 id="the-worst-fall">The worst fall</h2>
  </div>

  <DrawdownChart series={[own, market]} highlight="cautious" worst={fall} title="Falls from the last high" class="wide mt-8">
    Cautious against a plain world stock index, {file.window.label}. Zero is the last high; every dip is a fall from it.
  </DrawdownChart>

  <div class="prose mt-8">
    <p>From {monthName(fall.peak)} to {monthName(fall.trough)}, $10,000 fell to {formatDollars(fall.dollarsAtTrough)},
    a fall of {pct(fall.pct)}, and it was back above $10,000 in {fall.recovered ? monthName(fall.recovered) : "no month yet"},
    {formatMonths(fall.monthsToRecover)} after the peak. The plain world stock index fell to
    {formatDollars(m.worstFall.dollarsAtTrough)} and took {formatMonths(m.worstFall.monthsToRecover)}. In calendar
    2008 the portfolio lost {pct(s.calendarYears["2008"] ?? Number.NaN)} against {pct(m.calendarYears["2008"] ?? Number.NaN)} for
    the index. In 2022, when stocks and bonds fell together, it lost {pct(s.calendarYears["2022"] ?? Number.NaN)}, its
    worst calendar year since 1990, against {pct(m.calendarYears["2022"] ?? Number.NaN)} for the index and
    {pct(sixtyForty.summary.calendarYears["2022"] ?? Number.NaN)} for the 60/40 mix. A version built for a fall of
    about 30%, with SCHP at {weightOf("SCHP")}%, RSST at {weightOf("RSST")}% and the same six stock funds at
    {thirtyStocks}% together, fell {pct(thirty.summary.worstFall.pct)} since 1990, its deepest fall coming in
    {yearOf(thirty.summary.worstFall.trough)} rather than {yearOf(fall.trough)}, and {pct(longThirty.summary.worstFall.pct)} across
    1929 to 1932.</p>
  </div>

  <div class="prose mt-14">
    <h2 id="what-it-beat">What it beat, and by how much</h2>
    <p>Over {file.window.label} it grew {formatPct(s.cagrPct)} a year against {formatPct(m.cagrPct)} for a plain world
    stock index and {formatPct(sixtyForty.summary.cagrPct)} for a 60/40 mix, so on that history the smaller fall
    cost almost nothing, and the difference from the index is far too small to tell from luck. Over 96 years,
    1929 to 2025, it gave up about {formatPct(longMarket.summary.cagrPct - long.summary.cagrPct)} a year of growth
    against all US stocks. At today's likely returns, if stocks beat inflation-protected bonds by 0%, 1.5% or
    3% a year from here, holding half your money in bonds costs about 0%, 0.75% or 1.5% a year against all
    stocks.</p>
  </div>

  <div class="prose mt-14">
    <h2 id="who-it-is-for">Who it is for</h2>
    <p>Someone who would sell after a fall of about 40%. Every other portfolio on this site fell by about half
    at some point since 1990. If you would have sold partway through that, you need a smaller fall, and the
    only way to buy one is to hold fewer stocks. Pick the fall you would actually have held through for as
    many months as it lasted, not the one you could tolerate in the abstract. The label describes the past
    sixty years; across 1929 to 1932 this mix fell {pct(long.summary.worstFall.pct)}. If you are drawing on the
    money at more than about 4% a year, too few stocks is the larger risk.</p>
  </div>

  <div class="prose mt-14">
    <h2 id="how-to-hold-it">How to hold it</h2>
    <Callout kind="do-this">
      <p>SCHP goes into a pre-tax retirement account first, then a Roth, and a taxable account last: its interest
      and its inflation adjustment are taxed like wages, the adjustment before it is paid. RSST goes in before
      SCHP. At half the money, SCHP overflows most retirement accounts, so some of it will sit in a taxable
      account.</p>
      <p>Once a year, on a fixed date, send new money to whatever is furthest below its target. Trade only
      inside retirement accounts, and never sell in a taxable account to rebalance.</p>
      <p>If RSST announces it is closing, sell it before its last trading day and buy VTI in the same account.
      That mix, 51% stocks and 49% bonds, fell 21.6% since 1990 and 55.8% across 1929 to 1932. Replacement
      funds are reviewed in the order CTAP, MATE, JPFP, RSIT, and none passes its test yet. The details are on
      <a href="/how-to-hold/">how to hold it</a>.</p>
    </Callout>
  </div>

  <div class="prose mt-14">
    <h2 id="what-could-go-wrong">What could go wrong</h2>
    <p>Half the money is in one bond fund, and bonds did not protect anyone in 2022: this portfolio lost
    {pct(s.calendarYears["2022"] ?? Number.NaN)} that year and the 60/40 mix lost {pct(sixtyForty.summary.calendarYears["2022"] ?? Number.NaN)}.
    A portfolio holding only ten-year US government bonds fell 25.1% from August 2020 to October 2023 and spent
    65 months below its old high. Hold bonds for the smaller fall over a whole cycle, not as insurance against
    any one year. The 1929 to 1932 fall was {pct(long.summary.worstFall.pct)} even for this portfolio; being
    safe against those years needs fewer than 38% in stocks, a mix not scored here. The long history also runs
    a plain government bond through the inflation of the late 1970s, because inflation-protected bonds did not
    exist before 2003; across 1977 to 1981 this mix gained 36% while Plus trend gained 86%, and the real bonds
    would have done better by an amount no data can measure.</p>
  </div>

  <div class="prose mt-14">
    <h2 id="the-long-history">The long history</h2>
    <p>Over 1929 to 2025, simulated with US stocks only, a home-built four-market trend rule with no trading
    costs and a plain government bond in place of SCHP, $10,000 at the {monthName(long.summary.worstFall.peak)} peak
    fell to {formatDollars(long.summary.worstFall.dollarsAtTrough)} by {monthName(long.summary.worstFall.trough)}, a fall
    of {pct(long.summary.worstFall.pct)}, and took {formatMonths(long.summary.worstFall.monthsToRecover)} to get back; all
    US stocks fell {pct(longMarket.summary.worstFall.pct)} and took {formatMonths(longMarket.summary.worstFall.monthsToRecover)},
    and Plus trend fell {pct(longBefore.summary.worstFall.pct)}. Over the whole 96 years this portfolio grew
    {formatPct(long.summary.cagrPct)} a year against {formatPct(longMarket.summary.cagrPct)} for all US stocks and
    {formatPct(longBefore.summary.cagrPct)} for Plus trend. Nobody earned these returns, and nobody sat through
    those falls knowing how they would end.</p>
  </div>

  <div class="prose mt-10 flex flex-wrap gap-3">
    <Button href="/portfolios/">Compare all four</Button>
    <Button href="/portfolios/with-trend/" variant="outline">Portfolio 3: Plus trend</Button>
  </div>
</Base>
