---
/**
 * One big number: the value first and large in the serif, a plain sentence-case label
 * under it, and an optional note. Lives inside a `StatGrid`, which supplies the `<dl>`.
 *
 *     <StatGrid columns={4}>
 *       <StatTile value="$351,000" label="$10,000 became" note="1990 to 2026" />
 *       <StatTile value="−52.7%" unit="$4,730" label="Worst fall" />
 *     </StatGrid>
 *
 * `unit` prints small after the value, for a second reading of the same number ("−52.7%"
 * with "$4,730" beside it). Everything is text, so a page prints exactly what its source
 * did. A value with no digit in it, such as a confidence word, is set a step smaller so
 * it stays on one or two lines.
 */
export interface StatTileProps {
  readonly value: string;
  readonly label: string;
  readonly note?: string;
  /** A small second reading beside the value. */
  readonly unit?: string;
}

interface Props extends StatTileProps {
  class?: string;
}

const { value, label, note, unit, class: className } = Astro.props;
---

<div class:list={["stat", className]}>
  <dt class="stat-label">{label}</dt>
  <dd class="stat-value" data-numeric data-kind={/\d/.test(value) ? undefined : "word"}>
    {value}
    {unit && <small>{unit}</small>}
  </dd>
  {note && <dd class="stat-note">{note}</dd>}
</div>
