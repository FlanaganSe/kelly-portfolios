---
/**
 * How far below its last high a portfolio sat, month by month: the "underwater" chart.
 * Zero is the top of the plot and every dip is a fall from a peak, filled in, so a reader
 * sees at once how deep each fall went and how long it took to climb out.
 *
 * One or two series. The worst fall of the first (or highlighted) series is marked at
 * its low point with the dollars $10,000 had become and the months it took to get back.
 * The episode is computed from the values unless `worst` hands in the emitter's own
 * summary, which is the same arithmetic run in Python.
 *
 *     <DrawdownChart series={[withTrend, market]} highlight="with-trend" title="Falls from a peak">
 *       Plus trend against a plain world stock index, 1990 to 2026.
 *     </DrawdownChart>
 */
import {
  areaPath,
  drawdownTicks,
  drawdowns,
  formatDollars,
  formatPct,
  linePath,
  type Point,
  scaleLinear,
  type Series,
  worstFall,
  yearTicks,
} from "~/lib/charts";
import { isBenchmark, seriesColour } from "~/lib/palette";

interface WorstFall {
  readonly pct: number;
  readonly trough: string;
  readonly monthsToRecover: number | null;
  readonly dollarsAtTrough: number;
}

interface Props {
  series: readonly Series[];
  /** The series to draw on top and annotate. Defaults to the first. */
  highlight?: string;
  /** The emitter's summary of the worst fall, if the page has it; otherwise computed. */
  worst?: WorstFall;
  /** Plot height in CSS pixels on a wide screen. */
  height?: number;
  start?: number;
  title?: string;
  tickEvery?: number;
  /** Turn off the note at the low point. */
  annotate?: boolean;
  class?: string;
}

const {
  series,
  highlight,
  worst,
  height,
  start = 10000,
  title = "Falls from the last high",
  tickEvery = 5,
  annotate = true,
  class: className,
} = Astro.props;

if (series.length === 0 || series.length > 2) {
  throw new Error(`<DrawdownChart> takes one or two series, got ${series.length}.`);
}
for (const s of series) {
  if (s.values.length !== s.dates.length || s.values.length < 2) {
    throw new Error(`<DrawdownChart> series "${s.id}" needs matching values and dates, two or more of each.`);
  }
}

const W = 1000;
const H = 1000;
const dates = (series[0] as Series).dates;
const months = dates.length - 1;

const computed = series.map((s, index) => {
  const dd = drawdowns(s.values);
  return {
    ...s,
    index,
    colour: seriesColour(s.id, index),
    benchmark: isBenchmark(s.id),
    highlighted: highlight ? s.id === highlight : index === 0,
    dd,
    worstPct: Math.min(...dd),
  };
});

const floor = Math.min(...computed.map((s) => s.worstPct));
// A little room under the deepest trough for its marker, and no gridline below that.
const bottom = floor * 1.1;
const ticks = drawdownTicks(floor).filter((t) => t >= bottom);
const x = scaleLinear([0, months], [0, W]);
const y = scaleLinear([bottom, 0], [H, 0]);
const years = yearTicks(dates, tickEvery);

// The benchmark underneath, the annotated series on top.
const drawn = computed
  .map((s) => {
    const points = s.dd.map((v, i): Point => [x(i), y(v)]);
    return { ...s, line: linePath(points), area: areaPath(points, y(0)) };
  })
  .sort((a, b) => Number(a.highlighted) - Number(b.highlighted));

const subject = computed.find((s) => s.highlighted) ?? (computed[0] as (typeof computed)[number]);
const episode = worst ?? worstFall(subject, start);
const troughIndex = episode ? subject.dates.indexOf(episode.trough) : -1;
const note =
  annotate && episode && troughIndex >= 0
    ? {
        xPct: (x(troughIndex) / W) * 100,
        yPct: (y(episode.pct) / H) * 100,
        pct: formatPct(episode.pct),
        dollars: formatDollars(episode.dollarsAtTrough),
        recovery:
          episode.monthsToRecover === null
            ? "and has not yet got back to its high."
            : `and took ${episode.monthsToRecover} months to get back.`,
      }
    : null;

const slug = `drawdown-${series.map((s) => s.id).join("-")}`.replace(/[^a-z0-9-]/gi, "");
const description = `Percent below the previous high, ${(dates[0] as string).slice(0, 4)} to ${(
  dates[dates.length - 1] as string
).slice(0, 4)}. ${computed.map((s) => `${s.label} fell at most ${formatPct(s.worstPct)}`).join("; ")}.`;
---

<figure
  class:list={["chart", className]}
  style={height ? `--chart-h: ${height}px` : undefined}
>
  <div class="chart-frame">
    <div class="chart-canvas">
      <svg
        class="chart-svg"
        viewBox={`0 0 ${W} ${H}`}
        preserveAspectRatio="none"
        role="img"
        aria-labelledby={`${slug}-title ${slug}-desc`}
      >
        <title id={`${slug}-title`}>{title}</title>
        <desc id={`${slug}-desc`}>{description}</desc>
        {ticks.filter((t) => t !== 0).map((t) => <line class="chart-grid" x1={0} x2={W} y1={y(t)} y2={y(t)} />)}
        <line class="chart-base" x1={0} x2={W} y1={y(0)} y2={y(0)} />
        {drawn.map((s) => (
          <>
            <path class="chart-area" d={s.area} style={`--series-line: ${s.colour}`} />
            <path
              class="chart-line"
              d={s.line}
              style={`--series-line: ${s.colour}`}
              data-highlight={s.highlighted ? "true" : undefined}
              data-benchmark={s.benchmark ? "true" : undefined}
            />
          </>
        ))}
      </svg>

      {ticks.map((t) => (
        <span class="chart-ylabel" style={`top: ${(y(t) / H) * 100}%`} aria-hidden="true">
          {formatPct(t, 0)}
        </span>
      ))}

      {years.map((t) => (
        <span
          class="chart-xlabel"
          style={`left: ${(x(t.index) / W) * 100}%`}
          data-edge={x(t.index) / W > 0.94 ? "end" : x(t.index) / W < 0.05 ? "start" : undefined}
          data-minor={t.year % (tickEvery * 2) === 0 ? undefined : "true"}
          aria-hidden="true"
        >
          {t.year}
        </span>
      ))}

      {note && (
        <>
          <span
            class="chart-marker"
            style={`left: ${note.xPct}%; top: ${note.yPct}%; --series-line: ${subject.colour}`}
            aria-hidden="true"
          />
          <p
            class="chart-note"
            style={
              note.xPct < 55
                ? `left: calc(${note.xPct}% + 0.9rem); bottom: calc(${100 - note.yPct}% + 0.4rem)`
                : `right: calc(${100 - note.xPct}% + 0.9rem); bottom: calc(${100 - note.yPct}% + 0.4rem)`
            }
          >
            <b>{note.pct}</b> {formatDollars(start, "exact")} fell to {note.dollars} {note.recovery}
          </p>
        </>
      )}
    </div>
  </div>

  {series.length > 1 && (
    <ul class="chart-legend" aria-hidden="true">
      {computed.map((s) => (
        <li>
          <span
            class="chart-swatch"
            style={`--series-line: ${s.colour}`}
            data-benchmark={s.benchmark ? "true" : undefined}
          />
          <span>{s.label}</span>
          <b>{formatPct(s.worstPct)} at worst</b>
        </li>
      ))}
    </ul>
  )}

  <div class="sr-only">
  <table>
    <caption>{title}: the worst fall of each</caption>
    <thead>
      <tr>
        <th scope="col">Series</th>
        <th scope="col">Worst fall</th>
      </tr>
    </thead>
    <tbody>
      {computed.map((s) => (
        <tr>
          <th scope="row">{s.label}</th>
          <td>{formatPct(s.worstPct)}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>

  {Astro.slots.has("default") && (
    <figcaption class="chart-caption">
      <slot />
    </figcaption>
  )}
</figure>
