---
/**
 * A portfolio's holdings as a table: ticker, what the fund is in plain words, weight,
 * fee. Narrow enough to stay a table on a phone, so it does not use the stacking
 * pattern the wide comparison tables need.
 *
 *     <HoldingsTable rows={[{ ticker: "VT", what: "Every listed company in the world", weight: "100%", fee: "0.06%" }]} />
 */
export interface HoldingRow {
  readonly ticker: string;
  readonly what: string;
  readonly weight: string;
  readonly fee: string;
}

interface Props {
  rows: readonly HoldingRow[];
  caption?: string;
  class?: string;
}

const { rows, caption = "What the portfolio holds, and what each fund charges a year", class: className } = Astro.props;
---

<table class:list={["holdings w-full border-collapse text-base", className]}>
  <caption class="sr-only">{caption}</caption>
  <thead>
    <tr class="border-b border-rule-strong text-left">
      <th scope="col" class="label py-2 font-semibold pr-3">Fund</th>
      <th scope="col" class="label py-2 font-semibold pr-3">What it is</th>
      <th scope="col" class="label py-2 font-semibold pr-3 text-right">Weight</th>
      <th scope="col" class="label py-2 font-semibold text-right">Fee</th>
    </tr>
  </thead>
  <tbody class="text-ink-2">
    {
      rows.map((row) => (
        <tr class="border-b border-rule align-top last:border-0">
          <th scope="row" data-numeric class="py-2 pr-3 text-left font-medium text-ink">
            {row.ticker}
          </th>
          <td class="py-2 pr-3">{row.what}</td>
          <td data-numeric class="py-2 pr-3 text-right">
            {row.weight}
          </td>
          <td data-numeric class="py-2 text-right">
            {row.fee}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
