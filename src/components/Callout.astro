---
/**
 * A rule and a label. Not a coloured box, and never an emoji.
 *
 * Two kinds, because five were four more than a reader could hold apart. `do-this` is
 * the action. `caveat` is the thing that would break the claim, which is also where the
 * falsifier and the open question belong: all three are the same move — here is what
 * this does not carry — and giving each its own label made a page look like it was
 * arguing with itself. Anything that was a mechanism is prose; explaining why an effect
 * should exist is the body of the argument, not an aside beside it.
 *
 * `label` overrides the default, which is how a caveat says what specifically it is
 * qualifying rather than repeating the word on every one.
 */
const KINDS = {
  "do-this": { label: "Do this", rule: "var(--accent)" },
  caveat: { label: "Caveat", rule: "var(--cau)" },
} as const;

export type CalloutKind = keyof typeof KINDS;

interface Props {
  kind: CalloutKind;
  /** Overrides the default label. Keep it to a few words. */
  label?: string;
  class?: string;
}

const { kind, label, class: className } = Astro.props;

const meta = KINDS[kind];
if (!meta) {
  throw new Error(`<Callout kind="${kind}"> is unknown. Use one of: ${Object.keys(KINDS).join(", ")}.`);
}
---

<aside
  class:list={["my-6 max-w-measure border-l-[3px] pl-4", className]}
  style={`border-color: ${meta.rule}`}
>
  <p class="eyebrow mb-2">{label ?? meta.label}</p>
  <div class="text-base text-ink-2 [&>*+*]:mt-3"><slot /></div>
</aside>
