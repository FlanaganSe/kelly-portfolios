---
/**
 * Growth of $10,000: up to five monthly series on a log axis, each labelled at its right
 * end with the dollars it finished on.
 *
 * Built at build time as inline SVG, so it renders with scripts off and prints. The plot
 * stretches to fill its box (`preserveAspectRatio="none"`) with non-scaling strokes, and
 * every word is HTML positioned over it by percentage, so text stays a readable size at
 * 390px and 1100px alike. On a phone the end labels hide and a legend under the plot
 * carries the same names and dollars.
 *
 *     <GrowthChart series={file.series} highlight="with-trend" title="What $10,000 became">
 *       Four portfolios and a plain world stock index, 1990 to 2026.
 *     </GrowthChart>
 *
 * The series shape is the one `src/content/series/*.json` carries: `values` are dollar
 * levels from the start amount, `dates` are `YYYY-MM`, both the same length. Every
 * series is expected to share the first one's dates.
 */
import { formatDollars, growthTicks, linePath, type Point, scaleLinear, scaleLog, type Series, spreadLabels, yearTicks } from "~/lib/charts";
import { isBenchmark, seriesColour } from "~/lib/palette";

interface Props {
  series: readonly Series[];
  /** The id of the series drawn heavier and labelled larger. */
  highlight?: string;
  /** Plot height in CSS pixels on a wide screen. The phone height is fixed by CSS. */
  height?: number;
  /** The amount every series starts from. */
  start?: number;
  /** The accessible title of the chart. */
  title?: string;
  /** Years between x-axis ticks. */
  tickEvery?: number;
  class?: string;
}

const {
  series,
  highlight,
  height,
  start = 10000,
  title = `Growth of ${formatDollars(start, "exact")}`,
  tickEvery = 5,
  class: className,
} = Astro.props;

if (series.length === 0 || series.length > 5) {
  throw new Error(`<GrowthChart> takes one to five series, got ${series.length}.`);
}
for (const s of series) {
  if (s.values.length !== s.dates.length || s.values.length < 2) {
    throw new Error(`<GrowthChart> series "${s.id}" needs matching values and dates, two or more of each.`);
  }
}

const W = 1000;
const H = 1000;
const dates = (series[0] as Series).dates;
const months = dates.length - 1;

const all = series.flatMap((s) => s.values);
const lo = Math.min(...all) * 0.96;
const hi = Math.max(...all) * 1.06;
const x = scaleLinear([0, months], [0, W]);
const y = scaleLog([lo, hi], [H, 0]);

const ticks = growthTicks(lo, hi);
const years = yearTicks(dates, tickEvery);

const plotHeight = height ?? 320;
const labelGapPct = (34 / plotHeight) * 100;

// Benchmarks underneath, the highlighted series on top.
const drawn = series
  .map((s, index) => ({
    ...s,
    index,
    colour: seriesColour(s.id, index),
    benchmark: isBenchmark(s.id),
    highlighted: s.id === highlight,
    final: s.values[s.values.length - 1] as number,
    path: linePath(s.values.map((v, i): Point => [x(i), y(v)])),
  }))
  .sort((a, b) => Number(a.highlighted) - Number(b.highlighted) || Number(b.benchmark) - Number(a.benchmark));

const endY = drawn.map((s) => (y(s.final) / H) * 100);
const labelY = spreadLabels(endY, labelGapPct, labelGapPct / 2, 100 - labelGapPct / 2);

const slug = `growth-${series.map((s) => s.id).join("-")}`.replace(/[^a-z0-9-]/gi, "");
const first = dates[0] as string;
const last = dates[dates.length - 1] as string;
const description = `${formatDollars(start, "exact")} invested in ${first.slice(0, 4)}, month by month to ${last.slice(0, 4)}, on a scale where each gridline is a bigger step than the last. ${drawn
  .map((s) => `${s.label} finished on ${formatDollars(s.final)}`)
  .join("; ")}.`;
---

<figure
  class:list={["chart", className]}
  data-labels="end"
  data-size={plotHeight > 340 ? "tall" : undefined}
  style={height ? `--chart-h: ${height}px` : undefined}
>
  <div class="chart-frame">
    <div class="chart-canvas">
      <svg
        class="chart-svg"
        viewBox={`0 0 ${W} ${H}`}
        preserveAspectRatio="none"
        role="img"
        aria-labelledby={`${slug}-title ${slug}-desc`}
      >
        <title id={`${slug}-title`}>{title}</title>
        <desc id={`${slug}-desc`}>{description}</desc>
        {ticks.map((t) => <line class="chart-grid" x1={0} x2={W} y1={y(t)} y2={y(t)} />)}
        {drawn.map((s) => (
          <path
            class="chart-line"
            d={s.path}
            style={`--series-line: ${s.colour}`}
            data-highlight={s.highlighted ? "true" : undefined}
            data-benchmark={s.benchmark ? "true" : undefined}
          />
        ))}
      </svg>

      {ticks.map((t) => (
        <span class="chart-ylabel" style={`top: ${(y(t) / H) * 100}%`} aria-hidden="true">
          {formatDollars(t)}
        </span>
      ))}

      {years.map((t) => (
        <span
          class="chart-xlabel"
          style={`left: ${(x(t.index) / W) * 100}%`}
          data-edge={x(t.index) / W > 0.94 ? "end" : x(t.index) / W < 0.05 ? "start" : undefined}
          data-minor={t.year % (tickEvery * 2) === 0 ? undefined : "true"}
          aria-hidden="true"
        >
          {t.year}
        </span>
      ))}

      {drawn.map((s, i) => (
        <>
          <span
            class="chart-marker"
            style={`left: 100%; top: ${endY[i]}%; --series-line: ${s.colour}`}
            aria-hidden="true"
          />
          <span
            class="chart-end"
            style={`top: ${labelY[i]}%`}
            data-highlight={s.highlighted ? "true" : undefined}
            aria-hidden="true"
          >
            <span>{s.label}</span>
            <b>{formatDollars(s.final)}</b>
          </span>
        </>
      ))}
    </div>
  </div>

  <ul class="chart-legend" aria-hidden="true">
    {series.map((s, index) => (
      <li>
        <span
          class="chart-swatch"
          style={`--series-line: ${seriesColour(s.id, index)}`}
          data-benchmark={isBenchmark(s.id) ? "true" : undefined}
        />
        <span>{s.label}</span>
        <b>{formatDollars(s.values[s.values.length - 1] as number)}</b>
      </li>
    ))}
  </ul>

  <div class="sr-only">
  <table>
    <caption>{title}: what each finished on</caption>
    <thead>
      <tr>
        <th scope="col">Series</th>
        <th scope="col">Start</th>
        <th scope="col">Finish</th>
      </tr>
    </thead>
    <tbody>
      {series.map((s) => (
        <tr>
          <th scope="row">{s.label}</th>
          <td>{formatDollars(start, "exact")} in {first}</td>
          <td>{formatDollars(s.values[s.values.length - 1] as number, "exact")} in {last}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>

  {Astro.slots.has("default") && (
    <figcaption class="chart-caption">
      <slot />
    </figcaption>
  )}
</figure>
