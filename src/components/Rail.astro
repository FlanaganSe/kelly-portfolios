---
/**
 * A section label in the left rail.
 *
 * Put it immediately before the heading it names. On a wide screen it floats out into
 * the rail and sits level with the heading; below 78rem the rail is zero wide and the
 * label becomes an eyebrow above the heading, which is where a label of that kind
 * belongs on a narrow page anyway.
 *
 * It is the page's spine made visible: what to do, why, how sure, what would change our
 * mind. A reader scanning the rail should be able to see the shape of the argument
 * without reading a word of the body.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p class:list={["rail-label", className]}><slot /></p>
