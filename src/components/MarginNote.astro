---
/**
 * A note in the right margin: the source, the as-of date, the caveat, the number the
 * sentence deliberately left out.
 *
 * This site attaches provenance to almost every claim, and a parenthesis is the wrong
 * home for it — it interrupts the line and the reader skips it anyway. In the margin it
 * is available without being in the way, and on a phone it becomes an indented block
 * where the paragraph was.
 *
 * Put a note **immediately before** the paragraph it belongs to. It floats, so it lines
 * up with the block that follows it rather than the one above.
 *
 *     <MarginNote label="Source">
 *       <p>422 months to 2025-12. …</p>
 *     </MarginNote>
 *     <p>The measured correlation is 0.435.</p>
 */
interface Props {
  /** A short uppercase heading. Two or three words. Omit for an unlabelled aside. */
  label?: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<aside class:list={["margin-note", className]}>
  {label && <p class="eyebrow">{label}</p>}
  <slot />
</aside>
