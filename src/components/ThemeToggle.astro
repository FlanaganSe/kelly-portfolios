---
/**
 * Cycles system, light, dark, and stores the choice under `pe-theme`.
 *
 * Three settings, not two: `system` is the absence of a `data-theme` attribute, which
 * is what `styles.css` treats as "follow `prefers-color-scheme`". Written as a plain
 * script rather than an island, because hydrating a framework to toggle one attribute
 * would be the largest piece of JavaScript on an otherwise static page.
 */
---

<button
  type="button"
  id="theme-toggle"
  data-theme-setting="system"
  class="inline-flex h-8 w-8 items-center justify-center rounded-[3px] border border-rule text-ink-muted transition-colors hover:border-rule-strong hover:text-ink"
  title="Theme: match the system"
  aria-label="Theme is set to match the system. Switch to light."
>
  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" data-icon="system">
    <circle cx="8" cy="8" r="5.3" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
    <path d="M8 2.7a5.3 5.3 0 0 1 0 10.6Z" fill="currentColor"></path>
  </svg>
  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" data-icon="light" hidden fill="none" stroke="currentColor">
    <circle cx="8" cy="8" r="3.1" stroke-width="1.4"></circle>
    <path
      d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M12.95 3.05l-1.13 1.13M4.18 11.82l-1.13 1.13"
      stroke-width="1.4"
      stroke-linecap="round"></path>
  </svg>
  <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" data-icon="dark" hidden>
    <path
      d="M13.5 10.2A5.8 5.8 0 0 1 5.8 2.5a5.8 5.8 0 1 0 7.7 7.7Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  import { applyTheme, nextTheme, readStoredTheme, type ThemeSetting } from "~/lib/theme";

  const SETTING_LABEL: Record<ThemeSetting, string> = {
    system: "match the system",
    light: "light",
    dark: "dark",
  };

  const button = document.getElementById("theme-toggle");
  if (button) {
    const paint = (setting: ThemeSetting) => {
      button.dataset.themeSetting = setting;
      button.title = `Theme: ${SETTING_LABEL[setting]}`;
      button.setAttribute(
        "aria-label",
        `Theme is set to ${SETTING_LABEL[setting]}. Switch to ${SETTING_LABEL[nextTheme(setting)]}.`
      );
      for (const icon of button.querySelectorAll<SVGElement>("svg[data-icon]")) {
        icon.toggleAttribute("hidden", icon.dataset.icon !== setting);
      }
    };

    let setting = readStoredTheme();
    paint(setting);

    button.addEventListener("click", () => {
      setting = nextTheme(setting);
      applyTheme(setting);
      paint(setting);
    });
  }
</script>
