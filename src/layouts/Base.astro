---
/**
 * The shell every page renders inside: head, masthead, navigation, footer.
 *
 * `styles.css` is imported here and nowhere else, so the design system loads once and
 * the pre-paint theme script below can rely on it being the only source of colour.
 */
import ThemeToggle from "~/components/ThemeToggle.astro";
import { ogCard, OG_HEIGHT, OG_WIDTH } from "~/lib/og";
import {
  canonicalPath,
  CORPUS_AS_OF,
  isCurrent,
  NAV_ITEMS,
  type NavItem,
  REPO_URL,
  SITE_DESCRIPTION,
  SITE_NAME,
} from "~/lib/site";
import "~/styles.css";

interface Props {
  title: string;
  description?: string;
  /** Suppress the site name suffix when the page title already carries it. */
  bareTitle?: boolean;
  /**
   * Put this page in the search index. Off for the search page and the 404, which have
   * no words of their own and would otherwise match every query.
   */
  indexable?: boolean;
  /** Keep the page out of search-engine results. Used by the 404. */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  bareTitle = false,
  indexable = true,
  noindex = false,
} = Astro.props;

const pageTitle = bareTitle ? title : `${title} · ${SITE_NAME}`;
const pathname = Astro.url.pathname;

// `Astro.url` carries only the path — its origin is the dev server. The real origin is
// `site` in `astro.config.mjs`, which is what `Astro.site` returns and what the sitemap
// uses, so canonical and sitemap can never disagree.
const origin = Astro.site ?? new URL("https://kellyportfolios.com");
const canonical = new URL(canonicalPath(pathname), origin).href;

// Absolute, because every crawler that reads these resolves them from its own origin
// rather than from the page. Width, height and alt travel with the URL: a card whose
// dimensions a client cannot know gets rendered as a small square by several of them.
//
// `ogCard` throws on a route it has no card for, and every page on the site renders
// through here, so adding a page without a card fails the build. It used to hand back
// the home page's card instead, which is how the account-placement calculator came to
// be shared under the headline "Do the certain things first".
const card = ogCard(pathname, title);
const ogImage = new URL(card.src, origin).href;
const ogImageAlt = card.alt;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: origin.href,
  description: SITE_DESCRIPTION,
  inLanguage: "en",
  license: `${REPO_URL}/blob/main/README.md`,
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    url: origin.href,
  },
};

const navLink = "inline-block border-b-2 py-2 text-sm transition-colors";

/**
 * The footer's own links: the reference shelf, then the pages about the site itself.
 *
 * They live here rather than beside `NAV_ITEMS` on purpose. The masthead order is the
 * argument the site is making, and none of these belongs inside it — a reader reaches
 * them on a different errand. The masthead is five items and stays five, so everything
 * a reader arrives at sideways, from a link in a sentence rather than from the
 * navigation, has to be reachable here.
 *
 * The disclaimer is not in this list. It has its own sentence above, because a reader
 * who needs it is not scanning a row of link text for it.
 */
const FOOTER_ITEMS = [
  { href: "/start/", label: "Start here" },
  { href: "/portfolio/", label: "The portfolio" },
  { href: "/doesnt-work/", label: "What doesn’t work" },
  { href: "/lessons/", label: "What we’ve learned" },
  { href: "/glossary/", label: "Glossary" },
  { href: "/research/", label: "Research" },
  { href: "/methodology/", label: "Methodology" },
  { href: "/corrections/", label: "Corrections" },
  { href: "/disclosures/", label: "Disclosures" },
] as const satisfies readonly NavItem[];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141311" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    {/* Generated at build time by `src/pages/og/[...route].ts`. Every card is well
        under Bluesky's 1,000,000-byte thumbnail cap, which binds long before
        Facebook's 8MB one. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    {/* Applies the stored theme before first paint. Anything other than "light" or
        "dark" means "follow the system", which is the CSS default. Inline and
        unbundled on purpose: a deferred module would paint the wrong theme first. */}
    <script is:inline>
      try {
        var t = localStorage.getItem("pe-theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (_) {}
    </script>
  </head>

  <body>
    <div class="flex min-h-screen flex-col bg-paper text-ink">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-[3px] focus:bg-raised focus:px-3 focus:py-2 focus:text-sm"
      >
        Skip to content
      </a>

      {/* Five items, and the masthead is the whole of the site's first-level structure.
          The wordmark is the sixth destination and goes home. */}
      <header class="border-b border-rule">
        <div class="page-rail">
          <div class="flex items-center justify-between gap-4 pt-4 pb-3">
            <a
              href="/"
              class="font-serif text-[1.3125rem] font-semibold tracking-[-0.015em] text-ink transition-colors hover:text-accent"
            >
              {SITE_NAME}
            </a>
            <div class="flex items-center gap-4 text-xs text-ink-3">
              <span data-numeric class="hidden sm:inline">Research as of {CORPUS_AS_OF}</span>
              <a href="/search/" class="text-ink-2 transition-colors hover:text-ink">Search</a>
              <ThemeToggle />
            </div>
          </div>

          <nav aria-label="Sections">
            <ul class="flex flex-wrap gap-x-6">
              {
                NAV_ITEMS.map((item) => {
                  const current = isCurrent(item.href, pathname);
                  return (
                    <li>
                      <a
                        href={item.href}
                        aria-current={current ? "page" : undefined}
                        class:list={[
                          navLink,
                          current
                            ? "border-accent font-semibold text-ink"
                            : "border-transparent text-ink-2 hover:border-rule-strong hover:text-ink",
                        ]}
                      >
                        {item.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>
        </div>
      </header>

      {/* `data-pagefind-body` scopes the search index to the page's own words. Without
          it Pagefind indexes the masthead and footer on every page and every query
          matches everything. */}
      {/* The two-track canvas, centred: the reading measure, and a right-hand column for
          sources, dates and caveats. The aside collapses to zero width below 74rem, at
          which point every child is a single clean column. */}
      <main id="main" data-pagefind-body={indexable ? true : undefined} class="canvas flex-1 py-12 sm:py-16">
        <slot />
      </main>

      {/* The two-line disclaimer sits on every page because the condition it states is a
          condition of the whole site, not of one essay. `/disclaimer/` carries the full
          text and the reasoning; these two sentences are the part a reader has to see
          without clicking. */}
      <footer class="mt-24 border-t border-rule bg-sunken">
        <div class="page-rail flex flex-col gap-5 pt-8 pb-11 text-sm text-ink-2">
          <p class="max-w-measure">
            General information about investing, and no part of it is personalised advice. This site does not
            answer questions about an individual reader&rsquo;s portfolio.{" "}
            <a href="/disclaimer/" class="link font-semibold">Read the full disclaimer</a>.
          </p>

          <nav aria-label="About this site">
            <ul class="flex flex-wrap gap-x-5 gap-y-2">
              {
                FOOTER_ITEMS.map((item) => (
                  <li>
                    <a href={item.href} class="link">
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          {/* The repository is the last thing on the page on purpose. It is where a
              reader goes to audit the work, which is an errand almost nobody is on,
              and it used to sit ahead of the disclaimer. */}
          <p class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-xs text-ink-3">
            <span data-numeric>Research as of {CORPUS_AS_OF}</span>
            <a href={REPO_URL} rel="noopener noreferrer" class="link">Source on GitHub</a>
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
