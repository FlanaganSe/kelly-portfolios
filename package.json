{
  "name": "portfolio-edge",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:legacy": "vite",
    "build": "astro build && node scripts/check-og-size.mjs",
    "build:legacy": "vite build --outDir dist-legacy && node scripts/spa-fallback.mjs dist-legacy",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:prose": "node tools/prose-lint.mjs src/pages src/layouts src/content src/components/*.astro src/components/charts/*.astro",
    "biome:fix": "biome check --write .",
    "prepare": "git config core.hooksPath scripts/githooks && chmod +x scripts/githooks/*",
    "lint:figures": "node tools/check-figures.mjs src/content/figures"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.7",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/solid-js": "7.0.2",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.4",
    "astro": "7.2.4",
    "astro-og-canvas": "0.13.0",
    "astro-pagefind": "2.0.1",
    "canvaskit-wasm": "^0.42.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@playwright/test": "^1.62.1",
    "@pulumi/aws": "^7.16.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "~4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22",
    "js-yaml": "^5.3.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "sst": "3.17.38",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.1.10"
  }
}
