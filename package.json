    "@biomejs/biome": "2.2.4",
    "@preact/preset-vite": "~2.10.2",
    "@tailwindcss/vite": "~4.1.14",
    "@types/node": "^22",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}