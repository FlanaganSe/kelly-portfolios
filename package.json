{
  "name": "portfolio-edge",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-og-size.mjs && node scripts/check-links.mjs dist",
    "preview": "astro preview",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:prose": "node tools/prose-lint.mjs src/pages src/layouts src/content src/components/*.astro",
    "biome:fix": "biome check --write .",
    "prepare": "git config core.hooksPath scripts/githooks && chmod +x scripts/githooks/*",
    "lint:figures": "node tools/check-figures.mjs src/content/figures",
    "lint:links": "node scripts/check-links.mjs dist",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/solid-js": "7.0.2",
    "astro": "7.3.1",
    "astro-pagefind": "2.0.1",
    "canvaskit-wasm": "^0.42.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "~4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.20.1",
    "js-yaml": "^5.4.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10"
  }
}
